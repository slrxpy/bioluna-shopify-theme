{%- comment -%} BioLuna: carduri categorii pe homepage {%- endcomment -%}
<style>
.bcat{padding:34px 16px 10px;max-width:1240px;margin:0 auto}
.bcat h2{font-size:26px;margin:0 0 6px;text-align:center}.bcat p.k{text-align:center;color:#8a7a7e;margin:0 0 20px;font-size:14px}
.bcat-g{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.bcat-t{position:relative;display:block;border-radius:18px;overflow:hidden;aspect-ratio:1/1;text-decoration:none;background:#f7eef1;transition:transform .25s ease,box-shadow .25s ease}
.bcat-t:hover{transform:translateY(-4px);box-shadow:0 16px 36px rgba(183,110,121,.18)}
.bcat-t img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s}.bcat-t:hover img{transform:scale(1.05)}
.bcat-t .o{position:absolute;inset:auto 0 0 0;padding:44px 14px 14px;background:linear-gradient(180deg,rgba(0,0,0,0),rgba(0,0,0,.62));color:#fff}
.bcat-t .o b{display:block;font-size:16px;line-height:1.2}.bcat-t .o span{font-size:12px;opacity:.9}
.bcat-t .n{position:absolute;top:10px;right:10px;background:rgba(255,255,255,.92);color:#1f1f1f;border-radius:999px;padding:4px 10px;font-size:11.5px;font-weight:800}
@media(max-width:900px){.bcat-g{grid-template-columns:repeat(3,1fr)}}
@media(max-width:640px){.bcat{padding:26px 12px 6px}.bcat h2{font-size:21px}.bcat-g{grid-template-columns:repeat(2,1fr);gap:10px}.bcat-t .o b{font-size:14px}}
</style>
<section class="bcat">
  {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
  {%- if section.settings.kicker != blank -%}<p class="k">{{ section.settings.kicker }}</p>{%- endif -%}
  <div class="bcat-g">
  {%- for block in section.blocks -%}
    {%- assign c = collections[block.settings.collection] -%}
    {%- if c != blank -%}
    {%- assign img = block.settings.image -%}
    {%- if img == blank -%}{%- assign img = c.image -%}{%- endif -%}
    {%- if img == blank -%}{%- assign img = c.products.first.featured_image -%}{%- endif -%}
    <a class="bcat-t" href="{{ c.url }}" {{ block.shopify_attributes }}>
      {%- if img != blank -%}<img src="{{ img | image_url: width: 600 }}" alt="{{ c.title | escape }}" loading="lazy">{%- endif -%}
      <span class="n">{{ c.products_count }} produse</span>
      <div class="o"><b>{{ block.settings.label | default: c.title }}</b>{%- if block.settings.sub != blank -%}<span>{{ block.settings.sub }}</span>{%- endif -%}</div>
    </a>
    {%- endif -%}
  {%- endfor -%}
  </div>
</section>
{% schema %}
{ "name": "BioLuna – Categorii", "settings": [
  {"type":"text","id":"heading","label":"Titlu","default":"Cumpără pe categorii"},
  {"type":"text","id":"kicker","label":"Subtitlu","default":"Alege ce ai nevoie – produse originale, livrare rapidă"}],
  "blocks": [{"type":"cat","name":"Categorie","settings":[
    {"type":"collection","id":"collection","label":"Colecție"},
    {"type":"text","id":"label","label":"Etichetă (opțional)"},
    {"type":"text","id":"sub","label":"Subtitlu mic (opțional)"},
    {"type":"image_picker","id":"image","label":"Poză (opțional, altfel poza colecției/primului produs)"}]}],
  "presets": [{"name":"BioLuna – Categorii"}] }
{% endschema %}
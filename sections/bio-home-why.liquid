<style>.bhw{max-width:1240px;margin:0 auto;padding:26px 16px}.bhw h2{text-align:center;margin:0 0 16px;font-size:24px}.bhw-g{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.bhw-c{background:#fff;border:1px solid #f0e6e9;border-radius:16px;padding:18px 16px;text-align:center}.bhw-c i{font-style:normal;font-size:30px;display:block;margin-bottom:8px}.bhw-c b{display:block;font-size:15px;margin-bottom:4px}.bhw-c span{font-size:13px;color:#8a7a7e;line-height:1.5}@media(max-width:800px){.bhw-g{grid-template-columns:repeat(2,1fr)}.bhw h2{font-size:20px}}</style>
<section class="bhw"><h2>{{ section.settings.heading }}</h2><div class="bhw-g">{%- for b in section.blocks -%}<div class="bhw-c"><i>{{ b.settings.icon }}</i><b>{{ b.settings.title }}</b><span>{{ b.settings.text }}</span></div>{%- endfor -%}</div></section>
{% schema %}{ "name":"BioLuna – De ce noi","settings":[{"type":"text","id":"heading","label":"Titlu","default":"De ce BioLuna"}],"blocks":[{"type":"c","name":"Argument","settings":[{"type":"text","id":"icon","label":"Emoji"},{"type":"text","id":"title","label":"Titlu"},{"type":"text","id":"text","label":"Text"}]}],"presets":[{"name":"BioLuna – De ce noi"}] }{% endschema %}

<style>.bhr{max-width:1240px;margin:0 auto;padding:26px 16px 6px}.bhr-k{font-size:11.5px;letter-spacing:1.6px;text-transform:uppercase;color:#d10a1e;font-weight:800;margin:0 0 4px}.bhr h2{margin:0 0 4px;font-size:25px}.bhr p{margin:0 0 12px;color:#8a7a7e;font-size:14px}.bhr-h{display:flex;justify-content:space-between;align-items:flex-end;gap:10px}.bhr-h a{color:#d10a1e;font-weight:800;text-decoration:none;font-size:14px;white-space:nowrap}
.bhr-row{display:flex;gap:12px;overflow-x:auto;padding:4px 2px 14px;scroll-snap-type:x mandatory}.bhr-row .bx-pcard{flex:0 0 220px}@media(max-width:640px){.bhr h2{font-size:20px}.bhr-row .bx-pcard{flex-basis:165px}}</style>
{%- assign c = collections[section.settings.collection] -%}
{%- if c != blank -%}
<section class="bhr bx"><div class="bhr-h"><div>{%- if section.settings.kicker != blank -%}<div class="bhr-k">{{ section.settings.kicker }}</div>{%- endif -%}<h2>{{ section.settings.heading | default: c.title }}</h2>{%- if section.settings.sub != blank -%}<p>{{ section.settings.sub }}</p>{%- endif -%}</div><a href="{{ c.url }}">Vezi toate →</a></div>
<div class="bhr-row">
{%- assign pinned = section.settings.pinned | split: ',' -%}{%- assign shown = '' -%}{%- assign n = 0 -%}
{%- for h in pinned -%}{%- assign hh = h | strip -%}{%- if hh != blank -%}{%- assign p = all_products[hh] -%}{%- if p and p.available -%}{%- render 'bio-card', p: p -%}{%- assign shown = shown | append: ',' | append: p.id -%}{%- assign n = n | plus: 1 -%}{%- endif -%}{%- endif -%}{%- endfor -%}
{%- for p in c.products -%}{%- if n >= section.settings.limit -%}{%- break -%}{%- endif -%}{%- assign pid = p.id | append: '' -%}{%- unless shown contains pid -%}{%- if p.available -%}{%- assign v = p.selected_or_first_available_variant -%}{%- if v.inventory_management == blank or v.inventory_quantity > 0 or v.inventory_policy == 'continue' -%}{%- render 'bio-card', p: p -%}{%- assign n = n | plus: 1 -%}{%- endif -%}{%- endif -%}{%- endunless -%}{%- endfor -%}
</div></section>
{%- endif -%}
{% schema %}{ "name":"BioLuna – Rând produse","settings":[{"type":"collection","id":"collection","label":"Colecție"},{"type":"text","id":"kicker","label":"Kicker"},{"type":"text","id":"heading","label":"Titlu"},{"type":"text","id":"sub","label":"Subtitlu"},{"type":"text","id":"pinned","label":"Handle-uri fixate primele (separate prin virgulă)"},{"type":"range","id":"limit","label":"Produse","min":4,"max":16,"step":1,"default":10}],"presets":[{"name":"BioLuna – Rând produse"}] }{% endschema %}

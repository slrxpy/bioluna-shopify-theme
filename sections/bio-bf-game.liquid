{%- comment -%} BioLuna BF – „Cumpără pe game” v2: carduri înalte cu poză, culoarea gamei, procent mare; se trag pe orizontală. {%- endcomment -%}
{%- assign st = section.settings -%}
<style>
.blf .gc-row{position:relative}
.blf .gc-track{display:flex;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding:6px 2px 14px}
.blf .gc-track::-webkit-scrollbar{display:none}
.blf .gc{position:relative;flex:0 0 calc(25% - 12px);scroll-snap-align:start;display:block;aspect-ratio:3/4.1;border-radius:26px;overflow:hidden;background:var(--c);box-shadow:0 10px 26px rgba(0,0,0,.12);transition:transform .25s,box-shadow .25s}
.blf .gc:hover{transform:translateY(-5px);box-shadow:0 22px 44px rgba(0,0,0,.2)}
.blf .gc img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .7s}
.blf .gc:hover img{transform:scale(1.07)}
.blf .gc:before{content:"";position:absolute;inset:0;z-index:1;background:var(--c);-webkit-mask-image:linear-gradient(180deg,transparent 30%,#000 82%);mask-image:linear-gradient(180deg,transparent 30%,#000 82%)}
.blf .gc:after{content:"";position:absolute;inset:0;z-index:1;border-radius:inherit;box-shadow:inset 0 0 0 1px rgba(255,255,255,.18);pointer-events:none}
.blf .gc__off{position:absolute;top:14px;left:14px;z-index:2;background:#fff;border-radius:14px;padding:8px 12px 7px;transform:rotate(-4deg);box-shadow:0 8px 18px rgba(0,0,0,.18);line-height:1}
.blf .gc__off small{display:block;font-size:9.5px;font-weight:800;color:#111;letter-spacing:.03em;margin-bottom:2px}
.blf .gc__off b{font-family:var(--bf-hf);font-weight:800;font-size:34px;line-height:.9;color:var(--bf-red2)}
.blf .gc__n{position:absolute;top:16px;right:14px;z-index:2;background:rgba(0,0,0,.38);color:#fff;border-radius:999px;padding:6px 11px;font-size:11.5px;font-weight:700;-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px)}
.blf .gc__o{position:absolute;left:0;right:0;bottom:0;z-index:2;padding:18px;color:#fff}
.blf .gc__o b{display:block;font-family:var(--bf-hf);font-weight:800;font-size:clamp(30px,2.9vw,42px);line-height:.92;text-transform:uppercase;color:#fff}
.blf .gc__o span{display:block;font-size:13.5px;color:#fff;opacity:.9;margin:6px 0 0}
.blf .gc__go{display:flex;align-items:center;justify-content:space-between;margin-top:14px;padding-top:12px;border-top:1px solid rgba(255,255,255,.28);font-size:12.5px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#fff}
.blf .gc__go i{font-style:normal;width:38px;height:38px;border-radius:50%;background:#fff;color:#111;display:flex;align-items:center;justify-content:center;font-size:17px;transition:transform .25s}
.blf .gc:hover .gc__go i{transform:translateX(4px)}
.blf .gc-row .bf-arrow{position:absolute;top:calc(50% - 30px);z-index:3;display:none}
.blf .gc-row .bf-arrow.l{left:-20px}.blf .gc-row .bf-arrow.r{right:-20px}
@media(min-width:1024px){.blf .gc-row .bf-arrow{display:flex}}
@media(max-width:1023px){.blf .gc{flex-basis:calc(40% - 8px)}}
@media(max-width:719px){.blf .gc-track{gap:12px;margin:0 -16px;padding:4px 16px 14px;scroll-padding-left:16px}.blf .gc{flex-basis:72%;border-radius:22px}.blf .gc__o b{font-size:34px}}
</style>
<section class="blf">
  <div class="bf-wrap bf-sec">
    <header class="bf-sec__h"><div>{%- if st.kicker != blank -%}<div class="bf-k">{{ st.kicker }}</div>{%- endif -%}<h2 class="bf-h">{{ st.title }}</h2>{%- if st.sub != blank -%}<p>{{ st.sub }}</p>{%- endif -%}</div></header>
    <div class="gc-row">
      <div class="gc-track">
      {%- for b in section.blocks -%}{%- assign bs = b.settings -%}{%- assign c = bs.collection -%}
        {%- if c != blank -%}
        {%- assign img = bs.image -%}{%- if img == blank -%}{%- assign img = c.image -%}{%- endif -%}{%- if img == blank -%}{%- assign img = c.products.first.featured_image -%}{%- endif -%}
        {%- assign mx = 0 -%}
        {%- for p in c.products limit: 50 -%}{%- if p.compare_at_price > p.price -%}{%- assign d = p.compare_at_price | minus: p.price | times: 100.0 | divided_by: p.compare_at_price | round -%}{%- if d > mx -%}{%- assign mx = d -%}{%- endif -%}{%- endif -%}{%- endfor -%}
        <a class="gc" style="--c:{{ bs.color | default: '#14306e' }}" href="{{ c.url }}" {{ b.shopify_attributes }}>
          {%- if img != blank -%}<img src="{{ img | image_url: width: 800 }}" alt="{{ bs.label | default: c.title | escape }}" loading="lazy" width="800" height="1090">{%- endif -%}
          {%- if mx > 0 -%}<span class="gc__off"><small>până la</small><b>−{{ mx }}%</b></span>{%- endif -%}
          <span class="gc__n">{{ c.products_count }} produse</span>
          <div class="gc__o"><b>{{ bs.label | default: c.title }}</b>{%- if bs.sub != blank -%}<span>{{ bs.sub }}</span>{%- endif -%}
            <div class="gc__go">{{ st.link_text | default: 'Vezi ofertele' }}<i>→</i></div></div>
        </a>
        {%- endif -%}
      {%- endfor -%}
      </div>
      <button class="bf-arrow l" type="button" aria-label="Anterior">‹</button><button class="bf-arrow r" type="button" aria-label="Următor">›</button>
    </div>
  </div>
</section>
<script>(function(){function init(){document.querySelectorAll('.gc-row').forEach(function(r){if(r._gc)return;r._gc=1;var tr=r.querySelector('.gc-track');
function mv(d){var c=tr.firstElementChild;var w=c?c.getBoundingClientRect().width+16:300;tr.scrollBy({left:d*w*2,behavior:'smooth'})}
r.querySelector('.bf-arrow.l').addEventListener('click',function(){mv(-1)});r.querySelector('.bf-arrow.r').addEventListener('click',function(){mv(1)});});}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();})();</script>
{% schema %}
{"name":"BF – Cumpără pe game","settings":[{"type":"text","id":"kicker","label":"Text mic","default":"Fiecare gamă rezolvă o nevoie"},{"type":"text","id":"title","label":"Titlu (<em> = roșu)","default":"Cumpără pe <em>game</em>"},{"type":"text","id":"sub","label":"Subtitlu"},{"type":"text","id":"link_text","label":"Text buton","default":"Vezi ofertele"}],
"blocks":[{"type":"g","name":"Gamă","settings":[{"type":"collection","id":"collection","label":"Colecție"},{"type":"text","id":"label","label":"Nume"},{"type":"text","id":"sub","label":"Subtitlu mic"},{"type":"color","id":"color","label":"Culoarea gamei","default":"#14306e"},{"type":"image_picker","id":"image","label":"Poză (gol = poza colecției)"}]}],
"max_blocks":12,"presets":[{"name":"BF – Cumpără pe game"}]}
{% endschema %}

{%- comment -%} BioLuna: pagina de cautare {%- endcomment -%}
<style>
.bsr{max-width:1240px;margin:0 auto;padding:22px 16px 6px}
.bsr-hero{background:linear-gradient(120deg,#fdf4f6,#fbe9ee 60%,#fdf6ec);border:1px solid #f2dde2;border-radius:20px;padding:22px 20px;text-align:center}
.bsr-hero h1{margin:0 0 6px;font-size:26px}.bsr-hero p{margin:0;color:#8a7a7e;font-size:14px}
.bsr-chips{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin:14px 0 0}
.bsr-chips a{background:#fff;border:1px solid #f2dde2;border-radius:999px;padding:7px 13px;font-size:13px;font-weight:700;color:#1f1f1f;text-decoration:none}
.bsr-chips a:hover{border-color:#d10a1e;color:#d10a1e}
.bsr-h{font-size:17px;font-weight:800;margin:22px 0 10px}
.bsr-tiles{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.bsr-tile{position:relative;border-radius:16px;overflow:hidden;aspect-ratio:4/3;text-decoration:none;background:#f7eef1}
.bsr-tile img{width:100%;height:100%;object-fit:cover;display:block}
.bsr-tile b{position:absolute;inset:auto 0 0 0;padding:26px 12px 12px;background:linear-gradient(180deg,transparent,rgba(0,0,0,.62));color:#fff;font-size:15px}
.bsr-row{display:flex;gap:12px;overflow-x:auto;padding:4px 2px 12px}
.bsr-empty{background:#fff;border:1px dashed #d48a9b;border-radius:16px;padding:18px;margin:14px 0;text-align:center;display:none}
.bsr-empty b{display:block;font-size:17px;margin-bottom:6px}
@media(max-width:640px){.bsr-tiles{grid-template-columns:repeat(2,1fr)}.bsr-hero h1{font-size:21px}}
</style>
<div class="bsr">
  <div class="bsr-hero">
    <h1>{%- if search.performed and search.terms != blank -%}Rezultate pentru „{{ search.terms }}”{%- else -%}Ce cauți azi?{%- endif -%}</h1>
    <p>{%- if search.performed -%}{{ search.results_count }} produse găsite{%- else -%}Caută după produs, brand sau nevoie{%- endif -%}</p>
    <div class="bsr-chips">
      {%- assign chips = section.settings.chips_list | newline_to_br | split: '<br />' -%}{%- for t in chips -%}{%- assign t2 = t | strip -%}{%- if t2 != blank -%}<a href="/search?q={{ t2 | url_encode }}">{{ t2 }}</a>{%- endif -%}{%- endfor -%}
    </div>
  </div>
  <div class="bsr-empty" id="bsr-empty"><b>Nu am găsit nimic pentru „{{ search.terms }}”</b>Încearcă un cuvânt mai general (ex. „șampon”, „ceai”, „magiun”) sau alege dintre categoriile de mai jos.</div>
  {%- if search.performed == false or search.results_count < 6 -%}
  <div class="bsr-h">Mergi direct la</div>
  <div class="bsr-tiles">
    {%- for block in section.blocks -%}{%- assign c = collections[block.settings.collection] -%}{%- if c != blank -%}
    <a class="bsr-tile" href="{{ c.url }}">{%- assign im = c.image | default: c.products.first.featured_image -%}{%- if im -%}<img src="{{ im | image_url: width: 500 }}" alt="{{ c.title | escape }}" loading="lazy">{%- endif -%}<b>{{ block.settings.label | default: c.title }}</b></a>
    {%- endif -%}{%- endfor -%}
  </div>
  <div class="bsr-h">⭐ Cele mai vândute</div>
  <div class="bsr-row bx">{%- for p in collections['all'].products -%}{%- if p.tags contains 'bestseller' and p.available -%}{%- render 'bio-card', p: p -%}{%- endif -%}{%- endfor -%}</div>
  {%- endif -%}
</div>
{%- if search.performed and search.results_count == 0 -%}<script>document.getElementById('bsr-empty').style.display='block';</script>{%- endif -%}
{% schema %}
{ "name":"BioLuna – Căutare", "settings":[{"type":"textarea","id":"chips_list","label":"Căutări populare (una pe rând)","default":"șampon usturoi\nceai ozlex\nrozmarin\nmagiun\nmască de păr\nodorizant\nspf"}],
  "blocks":[{"type":"tile","name":"Categorie","settings":[{"type":"collection","id":"collection","label":"Colecție"},{"type":"text","id":"label","label":"Etichetă"}]}],
  "presets":[{"name":"BioLuna – Căutare"}] }
{% endschema %}
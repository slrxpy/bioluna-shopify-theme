/* ===== timeline ===== */
const ease=t=>t<0?0:t>1?1:t*t*(3-2*t);
const easeOut=t=>1-Math.pow(1-(t<0?0:t>1?1:t),3);
const N=PRODUCTS.length;const T_INTRO=.09,T_DOOR0=.09,T_DOOR1=.20,SEG0=.21,SEG=(.965-SEG0)/N;
const isMobile=()=>innerWidth<900;
const ovHero=document.getElementById('ov-hero'),hint=document.getElementById('hint'),progDots=[...document.querySelectorAll('#prog i')],ptitle=document.getElementById('ptitle');
const chapOv=PRODUCTS.map((_,i)=>document.getElementById('ov-'+i));
let target=0,prog=0,mx=0,my=0,now=0;
function readScroll(){const sc=document.getElementById('scroller');const r=sc.getBoundingClientRect();const h=sc.offsetHeight-innerHeight;target=Math.min(1,Math.max(0,-r.top/h));}
addEventListener('scroll',readScroll,{passive:true});addEventListener('resize',()=>{resize();readScroll();});
addEventListener('pointermove',e=>{mx=(e.clientX/innerWidth-.5);my=(e.clientY/innerHeight-.5);},{passive:true});
document.getElementById('startBtn').addEventListener('click',e=>{e.preventDefault();const sc=document.getElementById('scroller');window.scrollTo({top:sc.offsetTop+(sc.offsetHeight-innerHeight)*(SEG0+.02),behavior:'smooth'});});
const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;

function resize(){const w=stageEl.clientWidth,h=stageEl.clientHeight;renderer.setSize(w,h,false);camera.aspect=w/h;camera.updateProjectionMatrix();}
resize();readScroll();

const camBase=new THREE.Vector3(),look=new THREE.Vector3();
function update(p){
  const mob=isMobile();
  /* box placement: right of the text on desktop */
  const bx=mob?0:1.55;root.position.set(bx,0,0);
  /* box yaw: sweeping intro */
  const yaw=-.42+ease(p/T_INTRO)*(.42-.16)+p*.10+Math.sin(now*.5)*.018; root.rotation.y=yaw;root.position.y=Math.sin(now*.8)*.012;if(window.__bd)window.__bd.position.x=bx;
  /* doors */

/* ===== products: curved photo face + solid core sized from the silhouette ===== */
const loader=new THREE.TextureLoader();loader.setCrossOrigin('anonymous');
function analyze(img){ // silhouette bands + dominant colour
  const S=96,c=document.createElement('canvas');c.width=S;c.height=S;const g=c.getContext('2d');g.drawImage(img,0,0,S,S);
  let d;try{d=g.getImageData(0,0,S,S).data;}catch(e){return null;}
  const rows=[];const hist=new Map();
  for(let y=0;y<S;y++){let l=-1,r=-1;for(let x=0;x<S;x++){const i=(y*S+x)*4;if(d[i+3]>120){if(l<0)l=x;r=x;const lum=d[i]*.3+d[i+1]*.59+d[i+2]*.11;if(lum<160){const k=((d[i]>>5)<<10)|((d[i+1]>>5)<<5)|(d[i+2]>>5);const e=hist.get(k)||[0,0,0,0];e[0]++;e[1]+=d[i];e[2]+=d[i+1];e[3]+=d[i+2];hist.set(k,e);}}}rows.push(l<0?0:(r-l+1)/S);}

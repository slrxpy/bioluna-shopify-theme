      const lx=hx+(tx-hx)*p2, ly=(hy+(liftY-hy)*p1)+(ty-(hy+(liftY-hy)))*p2+Math.sin(now*1.3+i)*.025*p2, lz=hz+(tz-hz)*p2;
      const v=new THREE.Vector3(lx,ly,lz).applyAxisAngle(new THREE.Vector3(0,1,0),root.rotation.y).add(root.position);
      pr.m.position.copy(v);
      pr.m.scale.set(s,s,s);
      const spin=(1-rr)*-0.9 + Math.sin(now*.7+i*1.7)*.28*rr + (mx*.5)*rr;
      pr.m.rotation.set(-.06*rr+Math.sin(now*.9)*.03*rr, root.rotation.y*(1-rr)+spin, .03*Math.sin(now*1.1)*rr);
      const op=Math.min(1,out*1.6);if(pr.mat)pr.mat.opacity=op;if(pr.coreMat)pr.coreMat.opacity=op;
      glint.position.set(v.x+1.4,v.y+1.2,v.z+1.6);glint.intensity=.9*rr;
    }
    if(t>.1&&t<.9)active=i;
    chapOv[i].classList.toggle('on',t>.16&&t<.88);
  }
  ovHero.classList.toggle('on',p<T_DOOR0*.9);ptitle.style.opacity=p<T_DOOR1?1:0;
  endOv.classList.toggle('on',p>.965);hint.style.opacity=p<.04?1:0;
  progDots.forEach((d,i)=>d.classList.toggle('on',i===active));
}
function loop(){now=performance.now()/1000;prog+=(target-prog)*(reduce?1:.085);update(prog);renderer.render(scene,camera);requestAnimationFrame(loop);}
document.fonts?document.fonts.ready.then(()=>{canvas.classList.add('ready');redrawFaces();drawers.forEach((d,i)=>{d.g.children[0].material[4].map=tex(drawerFaceCanvas(i+1));});loop();}):loop();


cab.add(box(W-2*T,T*.5,D-2*T,mDark,0,H/2-T*1.25,0,false));cab.add(box(W-2*T,T*.5,D-2*T,mDark,0,-H/2+T*1.25,0,false));
// gold trim line on top front edge
cab.add(box(W,.012,.012,mGold,0,H/2+.001,D/2-.006,false));
cab.add(box(W,.012,.012,mGold,0,-H/2-.001,D/2-.006,false));cab.add(box(.012,H,.012,mGold,-W/2-.001,0,D/2-.006,false));cab.add(box(.012,H,.012,mGold,W/2+.001,0,D/2-.006,false));

/* drawers: 2 cols x 3 rows */
const cols=2,rows=3,gap=.09,innerW=W-2*T-gap*(cols+1),innerH=H-2*T-gap*(rows+1),dw=innerW/cols,dh=innerH/rows,dd=D-2*T-.08;

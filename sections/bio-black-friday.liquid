PRODUCTS.forEach((p,i)=>{
  const d=drawers[i];if(!d)return;
  const grp=new THREE.Group();grp.visible=false;scene.add(grp);
  const rec={m:grp,home:new THREE.Vector3(d.x,d.y-dh/2+.03,D/2-.05-dd/2),i,ph:dh*.92,mat:null};
  products.push(rec);
  loader.load(p.img,tx=>{
    tx.encoding=THREE.sRGBEncoding;tx.minFilter=THREE.LinearFilter;tx.anisotropy=8;
    const ar=tx.image.width/tx.image.height;const ph=dh*.92,pw=ph*ar;rec.ph=ph;
    const wide=ar>.85;const A=THREE.MathUtils.degToRad(wide?55:105);const r=pw/A;
    const geo=new THREE.CylinderGeometry(r,r,ph,64,1,true,-A/2,A);
    const mat=new THREE.MeshStandardMaterial({map:tx,emissiveMap:tx,emissive:0xffffff,emissiveIntensity:.42,roughness:.42,metalness:.05,transparent:true,alphaTest:.1,side:THREE.DoubleSide,opacity:0});

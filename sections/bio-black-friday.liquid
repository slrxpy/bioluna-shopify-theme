/* soft vignette backdrop behind the box */
(function(){const c=document.createElement('canvas');c.width=c.height=512;const g=c.getContext('2d');const gr=g.createRadialGradient(256,256,20,256,256,256);gr.addColorStop(0,'rgba(255,250,240,1)');gr.addColorStop(.55,'rgba(244,237,226,.6)');gr.addColorStop(1,'rgba(244,237,226,0)');g.fillStyle=gr;g.fillRect(0,0,512,512);

    const ob=x=>{x=x<0?0:x>1?1:x;const c1=1.4,c3=c1+1;return 1+c3*Math.pow(x-1,3)+c1*Math.pow(x-1,2);};const out=ob(t/.22)*(1-ease((t-.86)/.14));

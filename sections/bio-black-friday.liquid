{%- comment -%} BioLuna — Black Friday scroll-story 3D (three.js). v2 24.09.2026 — cutia Sadoer Rozmarin {%- endcomment -%}
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet">
<style>

.bf3d{--paper:#f4ede2;--paper-2:#ece3d3;--ink:#1f1a16;--ink-2:#5a5148;--gold:#b8873a;--gold-2:#d9b56b;--night:#1c1917;--red:#d10a1e;--green:#2f5d3a;
  --serif:"Cormorant Garamond",Georgia,serif;--sans:"Poppins",-apple-system,"Segoe UI",Roboto,Arial,sans-serif;box-sizing:border-box;
}
.bf3d *,.bf3d *::before,.bf3d *::after{box-sizing:border-box}
.bf3d{background:var(--paper);color:var(--ink);font-family:var(--sans);font-size:16px;line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:clip}
.bf3d img{max-width:100%;display:block} a{color:inherit}
.bf3d h1, .bf3d h2, .bf3d h3{font-family:var(--serif);font-weight:500;line-height:1;margin:0}
.bf3d .wrap{width:min(1180px,92vw);margin:0 auto}

.bf3d .strip{position:sticky;top:var(--hdr,0px);z-index:30;background:var(--night);color:#f4ede2;font-size:13px}
.bf3d .strip .wrap{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:44px}
.bf3d .strip .tag{font-family:var(--serif);font-size:18px;letter-spacing:.12em;text-transform:uppercase;color:var(--gold-2)}
.bf3d .cd{display:flex;align-items:center;gap:10px;white-space:nowrap}.cd .lbl{opacity:.75}.cd b{font-weight:500;font-variant-numeric:tabular-nums;font-size:15px}.cd b i{font-style:normal;opacity:.55;margin:0 3px 0 1px;font-size:12px}
@media (max-width:640px){.strip .tag{font-size:14px}.cd .lbl{display:none}}

/* ---- the scroll scrubber ---- */
.bf3d .scroller{position:relative;height:820vh}
.bf3d .stage{position:sticky;top:calc(var(--hdr,0px) + var(--strip,44px));height:calc(100vh - var(--hdr,0px) - var(--strip,44px));height:calc(100svh - var(--hdr,0px) - var(--strip,44px));overflow:hidden}
.bf3d .stage canvas{position:absolute;inset:0;width:100%;height:100%;display:block;opacity:0;transition:opacity .9s}.stage canvas.ready{opacity:1}
.bf3d .ptitle{position:absolute;left:0;right:0;top:26px;text-align:center;pointer-events:none;transition:opacity .4s}
.bf3d .ptitle h2{font-size:clamp(22px,3vw,40px);letter-spacing:.22em;text-transform:uppercase;color:#4a2f1f}
.bf3d .ov{position:absolute;left:4vw;top:50%;transform:translateY(-50%);width:min(40vw,540px);opacity:0;pointer-events:none;transition:opacity .35s,transform .5s}
.bf3d .ov.on{opacity:1;pointer-events:auto}
.bf3d .ov h1{font-size:clamp(52px,7vw,104px)} .ov h2{font-size:clamp(42px,5.6vw,80px)}
.bf3d .l2{display:block;color:var(--gold);font-style:italic}
.bf3d .ov .eyebrow{font-family:var(--serif);font-size:15px;letter-spacing:.18em;text-transform:uppercase;color:#4a2f1f;margin-bottom:18px}
.bf3d .ov p{max-width:36ch;color:var(--ink-2);font-size:clamp(15px,1.15vw,17px);margin:20px 0}
.bf3d .btn{display:inline-flex;align-items:center;justify-content:center;border:0;cursor:pointer;text-decoration:none;font-family:var(--sans);font-weight:600;font-size:15px;border-radius:999px;padding:15px 30px;background:var(--gold);color:#fff;box-shadow:0 10px 26px -12px rgba(184,135,58,.9);transition:transform .2s}
.bf3d .btn:hover{transform:translateY(-1px)} .btn:focus-visible{outline:3px solid var(--ink);outline-offset:3px}
.bf3d .btn.red{background:var(--red);box-shadow:0 10px 26px -12px rgba(209,10,30,.8)} .btn.ghost{background:transparent;color:var(--ink);box-shadow:inset 0 0 0 1.5px var(--ink)}
.bf3d .price{display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;margin:6px 0 18px}
.bf3d .price .now{font-family:var(--serif);font-size:42px;font-weight:600;color:var(--red);line-height:1}
.bf3d .price .old{color:var(--ink-2);text-decoration:line-through} .price .save{font-size:13px;font-weight:600;color:var(--red);background:rgba(209,10,30,.08);padding:4px 10px;border-radius:999px}
.bf3d .ctas{display:flex;gap:12px;flex-wrap:wrap} .omni{font-size:12px;color:var(--ink-2);margin-top:12px;max-width:40ch}
.bf3d .hint{position:absolute;left:50%;bottom:calc(22px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-2);display:flex;flex-direction:column;align-items:center;gap:8px;transition:opacity .4s;pointer-events:none}
.bf3d .hint i{width:1px;height:34px;background:var(--gold);display:block;animation:hint 1.6s ease-in-out infinite}
@keyframes hint{0%{transform:scaleY(0);transform-origin:top}50%{transform:scaleY(1);transform-origin:top}51%{transform-origin:bottom}100%{transform:scaleY(0);transform-origin:bottom}}
.bf3d .prog{position:absolute;right:4vw;top:50%;transform:translateY(-50%);display:flex;flex-direction:column;gap:10px}
.bf3d .prog i{width:6px;height:6px;border-radius:50%;background:rgba(0,0,0,.15);display:block;transition:background .3s,transform .3s}
.bf3d .prog i.on{background:var(--gold);transform:scale(1.5)}
@media (max-width:900px){
.bf3d .ov{left:5vw;right:5vw;width:auto;top:auto;bottom:calc(18px + env(safe-area-inset-bottom,0px));transform:none;padding-top:20px;background:linear-gradient(rgba(244,237,226,0),var(--paper) 22%)}
.bf3d .ov h1{font-size:clamp(40px,11vw,60px)} .ov h2{font-size:clamp(34px,9vw,52px)}
.bf3d .ov p{font-size:14px;margin:12px 0;max-width:none} .ov .eyebrow{margin-bottom:10px;font-size:13px}
.bf3d .price .now{font-size:32px} .price{margin-bottom:12px} .btn{padding:13px 22px;font-size:14px}
.bf3d .prog{display:none} .hint{bottom:auto;top:calc(44px + env(safe-area-inset-top,0px) + 70px)} .ptitle{display:none}
}

/* ---- after the story ---- */
.bf3d .all{padding:80px 0 50px;background:var(--paper-2)}
.bf3d .all h2{font-size:clamp(40px,5.4vw,76px);text-align:center}
.bf3d .all .lead{text-align:center;max-width:48ch;margin:16px auto 40px;color:var(--ink-2)}
.bf3d .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
@media (max-width:900px){.cards{grid-template-columns:repeat(2,1fr);gap:12px}}
.bf3d .card{background:var(--paper);border:1px solid rgba(0,0,0,.06);padding:18px;text-decoration:none;position:relative;display:flex;flex-direction:column;gap:10px}
.bf3d .card .im{aspect-ratio:1;display:grid;place-items:center;padding:8px}.card .im img{max-height:100%;object-fit:contain}
.bf3d .card .n{font-family:var(--serif);font-size:24px;line-height:1.1;font-weight:600}.card .s{font-size:13px;color:var(--ink-2)}
.bf3d .card .p{display:flex;gap:10px;align-items:baseline;margin-top:auto}.card .p b{color:var(--red);font-size:20px;font-weight:600;white-space:nowrap}.card .p s{font-size:13px;color:var(--ink-2)}
.bf3d .card .stk{position:absolute;left:12px;top:12px;background:var(--red);color:#fff;border-radius:999px;font-size:12px;font-weight:600;padding:5px 10px}
@media (max-width:900px){.card{padding:12px}.card .n{font-size:18px}.card .p b{font-size:16px}.card .s{font-size:12px}}
.bf3d .center{text-align:center;margin-top:34px}
.bf3d .faq{padding:70px 0 90px}.faq h2{font-size:clamp(36px,4.4vw,60px);margin-bottom:26px}
.bf3d .faq details{border-top:1px solid rgba(0,0,0,.12);padding:16px 0}.faq details:last-of-type{border-bottom:1px solid rgba(0,0,0,.12)}
.bf3d .faq summary{cursor:pointer;font-weight:600;font-size:17px;list-style:none;display:flex;justify-content:space-between;gap:16px}
.bf3d .faq summary::after{content:"+";font-family:var(--serif);font-size:26px;line-height:1;color:var(--gold)}.faq details[open] summary::after{content:"–"}
.bf3d .faq details p{color:var(--ink-2);margin:10px 0 0;max-width:70ch}
.bf3d .foot{padding:26px 0 40px;font-size:12px;color:var(--ink-2);text-align:center}
@media (prefers-reduced-motion:reduce){.hint i{animation:none}}


.bf3d h1,.bf3d h2,.bf3d h3,.bf3d .price .now,.bf3d .card .n{font-family:var(--serif) !important;font-weight:500 !important;line-height:1 !important;letter-spacing:0 !important;text-transform:none !important;margin:0 !important}
.bf3d .price .now,.bf3d .card .n{font-weight:600 !important}
.bf3d .ov h1{font-size:clamp(52px,7vw,104px) !important}.bf3d .ov h2{font-size:clamp(42px,5.6vw,80px) !important}
.bf3d .all h2{font-size:clamp(40px,5.4vw,76px) !important}.bf3d .faq h2{font-size:clamp(36px,4.4vw,60px) !important}
.bf3d .ptitle h2{font-size:clamp(22px,3vw,40px) !important;letter-spacing:.22em !important;text-transform:uppercase !important}
.bf3d .strip .tag{font-family:var(--serif) !important;white-space:nowrap}
.bf3d .strip .wrap{flex-wrap:nowrap}
@media (max-width:640px){.bf3d .strip .tag{font-size:13px !important;letter-spacing:.1em}.bf3d .cd b{font-size:13px}.bf3d .ov{background:linear-gradient(rgba(244,237,226,0),var(--paper) 38%);padding-top:34px}}
.bf3d .btn,.bf3d .btn:hover{font-family:var(--sans) !important;text-transform:none !important;letter-spacing:.01em !important;border-radius:999px !important;line-height:1.2 !important;min-height:0 !important;height:auto !important;text-decoration:none !important}
.bf3d p{margin:20px 0}.bf3d .ov .eyebrow{font-family:var(--serif) !important}
@media (max-width:900px){.bf3d .ov h1{font-size:clamp(40px,11vw,60px) !important}.bf3d .ov h2{font-size:clamp(34px,9vw,52px) !important}.bf3d .card .n{font-size:18px !important}}

.bf3d .bfgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:26px}
.bf3d .bfcard{position:relative;display:flex;flex-direction:column;background:#faf6ef;border:1px solid rgba(184,135,58,.28);text-decoration:none !important;color:var(--ink);overflow:hidden;transition:transform .25s,box-shadow .25s,border-color .25s}
.bf3d .bfcard::before{content:"";position:absolute;inset:8px;border:1px solid rgba(184,135,58,.35);pointer-events:none}
.bf3d .bfcard:hover{transform:translateY(-4px);box-shadow:0 26px 40px -30px rgba(60,40,10,.45);border-color:rgba(184,135,58,.6)}
.bf3d .bfim{height:270px;display:grid;place-items:center;padding:28px 28px 8px;background:radial-gradient(ellipse at 50% 70%,rgba(184,135,58,.16),rgba(184,135,58,0) 65%)}
.bf3d .bfim img{max-height:230px !important;max-width:80% !important;width:auto !important;height:auto !important;object-fit:contain;filter:drop-shadow(0 18px 18px rgba(0,0,0,.18));transition:transform .35s}
.bf3d .bfcard:hover .bfim img{transform:translateY(-6px) scale(1.03)}
.bf3d .bfbody{padding:6px 26px 26px;display:flex;flex-direction:column;gap:6px;text-align:center}
.bf3d .bfn{font-family:var(--serif) !important;font-size:27px !important;font-weight:600 !important;line-height:1.1 !important;letter-spacing:0 !important;text-transform:none !important;margin:0 !important}
.bf3d .bfs{font-size:13px;color:var(--ink-2)}
.bf3d .bfp{display:flex;gap:10px;align-items:baseline;justify-content:center;margin-top:8px}
.bf3d .bfp b{font-family:var(--serif) !important;color:var(--red);font-size:30px;font-weight:600;white-space:nowrap;line-height:1}
.bf3d .bfp s{font-size:14px;color:var(--ink-2)}
.bf3d .bfcta{margin-top:12px;align-self:center;font-size:13px;font-weight:600;letter-spacing:.02em;border-bottom:1.5px solid var(--gold);padding-bottom:2px;color:var(--ink)}
.bf3d .bfstk{position:absolute;left:18px;top:18px;z-index:2;width:52px;height:52px;border-radius:50%;background:var(--red);color:#fff;display:grid;place-items:center;font-size:14px;font-weight:600;transform:rotate(-8deg);box-shadow:0 8px 16px -8px rgba(209,10,30,.7)}
.bf3d .bfnum{position:absolute;right:20px;top:14px;font-family:var(--serif) !important;font-size:44px;color:rgba(184,135,58,.35);line-height:1}
@media (max-width:900px){.bf3d .bfgrid{grid-template-columns:repeat(2,1fr);gap:12px}.bf3d .bfim{height:180px;padding:22px 14px 4px}.bfim img{max-height:150px !important}.bf3d .bfbody{padding:4px 12px 16px}.bf3d .bfn{font-size:19px !important}.bf3d .bfp b{font-size:22px}.bf3d .bfstk{width:42px;height:42px;font-size:12px;left:10px;top:10px}.bf3d .bfnum{font-size:30px;right:12px;top:8px}.bf3d .bfcta{font-size:12px}}

@media (max-width:900px){
  .bf3d .ov{left:0;right:0;width:auto;top:auto;bottom:0;transform:none;padding:26px 5vw calc(14px + env(safe-area-inset-bottom,0px)) !important;background:linear-gradient(rgba(244,237,226,0),var(--paper) 26%) !important}
  .bf3d .ov p{display:none} .bf3d #ov-hero p,.bf3d #ov-end p{display:block;font-size:14px;margin:8px 0 12px}
  .bf3d .ov h1{font-size:clamp(38px,10vw,54px) !important} .bf3d .ov h2{font-size:clamp(30px,8.4vw,44px) !important}
  .bf3d .ov .eyebrow{margin-bottom:6px;font-size:12px}
  .bf3d .price{margin:8px 0 10px;gap:10px} .bf3d .price .now{font-size:30px !important} .bf3d .price .old{font-size:13px} .bf3d .price .save{font-size:11px;padding:3px 8px}
  .bf3d .ctas{gap:8px;flex-wrap:nowrap} .bf3d .ctas .btn{padding:12px 16px;font-size:13px;flex:1;white-space:nowrap}
  .bf3d .hint,.bf3d .prog,.bf3d .ptitle{display:none !important}
  .bf3d .bfim img{height:150px !important;max-height:150px !important;width:auto !important;max-width:82% !important}
}
/* EasySell / theme extras that cover the CTAs on this page only */
#es-popup-button,.es-popup-button,[class*="es-sticky"],[id*="es-sticky"]{display:none !important}
@media (max-width:900px){#wa-btn{bottom:calc(150px + env(safe-area-inset-bottom,0px)) !important;transform:scale(.85);transform-origin:bottom right}}
</style>

<div class="bf3d" id="bf3d-{{ section.id }}">

<div class="scroller" id="scroller">
<div class="strip"><div class="wrap"><div class="tag">Black Friday BioLuna</div><div class="cd" id="cd"><span class="lbl">Începe în</span><b id="cdv">—</b></div></div></div>
  <div class="stage" id="stage">
    <canvas id="c"></canvas>
    <div class="ptitle" id="ptitle"><h2>Black Friday</h2></div>
    <div class="ov" id="ov-hero">
      <h1>{{ section.settings.h1_line1 }} <span class="l2">{{ section.settings.h1_line2 }}</span></h1>
      <p>{{ section.settings.hero_text }}</p>
      <a class="btn" href="#poveste" id="startBtn">Deschide cutia</a>
    </div>
    <!--CHAPTERS-->
    <div class="ov" id="ov-end">
      <h2>Cutia e doar <span class="l2">începutul.</span></h2>
      <p>Toată gama Sadoer Rozmarin, cu prețul de Black Friday, plus restul reducerilor din magazin. Reducerea se aplică automat, fără cod.</p>
      <a class="btn red" href="#oferte">Vezi toate ofertele</a>
    </div>
    <div class="hint" id="hint"><span>Derulează</span><i></i></div>
    <div class="prog" id="prog"></div>
  </div>
</div>

<section class="all" id="oferte"><div class="wrap">
  <h2>{{ section.settings.all_title }}</h2>
  <p class="lead">{{ section.settings.all_text }}</p>
  <div class="bfgrid" id="cards"></div>
  <div class="center"><a class="btn red" href="{{ section.settings.all_url }}">{{ section.settings.all_cta }}</a></div>
</div></section>

<section class="faq"><div class="wrap">
  <h2>Întrebări frecvente</h2>
  <details><summary>Când începe și când se termină Black Friday la BioLuna?</summary><p>Începe pe <b class="d1"></b> și se încheie pe <b class="d2"></b>. Prețurile de pe această pagină sunt active doar în această perioadă.</p></details>
  <details><summary>Trebuie să folosesc un cod de reducere?</summary><p>Nu. Prețul de Black Friday e deja pus pe fiecare produs și se vede în coș. Nu se cumulează cu alte coduri.</p></details>
  <details><summary>Cum se calculează reducerea?</summary><p>Conform Directivei Omnibus, procentul se raportează la cel mai mic preț practicat de BioLuna în ultimele 30 de zile înainte de reducere.</p></details>
  <details><summary>Transportul e gratuit?</summary><p>Da, la comenzi de peste 300 lei. Sub această sumă se aplică taxa standard de livrare, afișată în coș.</p></details>
  <details><summary>Pot plăti ramburs?</summary><p>Da. Poți plăti ramburs la curier sau online, cu cardul, la plasarea comenzii.</p></details>
  <details><summary>Cât durează livrarea?</summary><p>Comenzile plasate până la ora 17:00 pleacă în aceeași zi și ajung de obicei în 1–2 zile lucrătoare.</p></details>
</div></section>
<div class="foot">{{ section.settings.omnibus_note }} Stoc limitat.</div>
</div>


<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>

/* ===== CONFIG ===== */
const BF={start:"{{ section.settings.start_date }}T00:00:00+02:00",end:"{{ section.settings.end_date }}T23:59:59+02:00"};
const PRODUCTS=[
{%- for block in section.blocks -%}{%- assign p = block.settings.product -%}{%- if p == blank -%}{%- continue -%}{%- endif -%}
  {%- assign pct = 0 -%}{%- if p.compare_at_price > p.price -%}{%- assign pct = p.compare_at_price | minus: p.price | times: 100 | divided_by: p.compare_at_price -%}{%- endif -%}
  {%- assign img = block.settings.asset -%}{%- if img != blank -%}{%- assign src = img | asset_url -%}{%- else -%}{%- assign src = p.featured_image | image_url: width: 1000 -%}{%- endif -%}
  {"handle":{{ p.handle | json }},"title":{{ p.title | json }},"url":{{ p.url | json }},"img":{{ src | json }},"vid":{{ p.selected_or_first_available_variant.id | json }},
   "now":{{ p.price | money_without_currency | json }},"ref":{{ p.compare_at_price | default: p.price | money_without_currency | json }},"pct":{{ pct }},
   "eyebrow":{{ block.settings.eyebrow | json }},"h1":{{ block.settings.h_line1 | json }},"h2":{{ block.settings.h_line2 | json }},"text":{{ block.settings.text | json }},"short":{{ block.settings.short | json }},"sub":{{ block.settings.sub | json }}}{% unless forloop.last %},{% endunless %}
{%- endfor -%}
];

/* ===== countdown ===== */
(function(){const el=document.getElementById('cdv'),lbl=document.querySelector('#cd .lbl');const s=new Date(BF.start),e=new Date(BF.end);const fmt=d=>d.toLocaleDateString('ro-RO',{day:'numeric',month:'long'});
document.querySelectorAll('.d1').forEach(x=>x.textContent=fmt(s));document.querySelectorAll('.d2').forEach(x=>x.textContent=fmt(e));
function tick(){const n=new Date();let t,txt;if(n<s){t=s-n;txt='Începe în';}else if(n<e){t=e-n;txt='Se termină în';}else{el.textContent='Black Friday s-a încheiat';lbl.textContent='';return;}
lbl.textContent=txt;const d=Math.floor(t/864e5),h=Math.floor(t%864e5/36e5),m=Math.floor(t%36e5/6e4),sc=Math.floor(t%6e4/1e3);
el.innerHTML=(d?d+'<i>z</i>':'')+String(h).padStart(2,'0')+'<i>h</i>'+String(m).padStart(2,'0')+'<i>m</i>'+String(sc).padStart(2,'0')+'<i>s</i>';}tick();setInterval(tick,1000);})();

/* ===== DOM: chapters + cards ===== */
const lei=v=>String(v).replace('.',',')+' lei';
const ROOT=document.getElementById('bf3d-{{ section.id }}');
const HDR=(function(){const hs=[...document.querySelectorAll('[id*="__header"], #shopify-section-header, .section-header, .header-wrapper, header')].filter(h=>h.getBoundingClientRect().height>0);const st=ROOT.querySelector('.strip');
  function m(){let b=0;hs.forEach(h=>{const r=h.getBoundingClientRect();const cs=getComputedStyle(h);if((cs.position==='sticky'||cs.position==='fixed')&&r.top<=1&&r.bottom>0)b=Math.max(b,r.bottom);});ROOT.style.setProperty('--hdr',Math.round(b)+'px');if(st)ROOT.style.setProperty('--strip',st.offsetHeight+'px');return b;}
  m();addEventListener('scroll',m,{passive:true});addEventListener('resize',m);return m;})();
const stageEl=document.getElementById('stage'), endOv=document.getElementById('ov-end');
PRODUCTS.forEach((p,i)=>{
  const pct=p.pct, now=p.now, ref=p.ref;
  const ov=document.createElement('div');ov.className='ov';ov.id='ov-'+i;
  ov.innerHTML=`<div class="eyebrow">Sertarul ${i+1} — ${p.eyebrow}</div><h2>${p.h1}<span class="l2">${p.h2}</span></h2><p>${p.text}</p>
  <div class="price"><span class="now">${lei(now)}</span>${pct>=5?`<span class="old">${lei(ref)}</span><span class="save">−${pct}%</span>`:``}</div>
  <div class="ctas"><a class="btn red" href="${p.url}">Cumpără acum</a><button type="button" class="btn ghost bf-add" data-vid="${p.vid}">Adaugă în coș</button></div>`;
  stageEl.insertBefore(ov,endOv);

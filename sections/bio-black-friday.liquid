/* geometry helpers */
function box(w,h,d,mat,x=0,y=0,z=0,shadow=true){const m=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),mat);m.position.set(x,y,z);m.castShadow=shadow;m.receiveShadow=true;return m;}

/* ===== build the cabinet ===== */
const W=2.3,H=2.7,D=1.5,T=.06;
const root=new THREE.Group();scene.add(root);
const cab=new THREE.Group();root.add(cab);
cab.add(box(W,T,D,mCream,0,H/2-T/2,0));       // top
cab.add(box(W,T,D,mCream2,0,-H/2+T/2,0));     // bottom
cab.add(box(T,H,D,mCream,-W/2+T/2,0,0));      // left
cab.add(box(T,H,D,mCream,W/2-T/2,0,0));       // right

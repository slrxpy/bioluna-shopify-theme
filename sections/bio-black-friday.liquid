    face.customDepthMaterial=new THREE.MeshDepthMaterial({depthPacking:THREE.RGBADepthPacking,map:tx,alphaTest:.35});
    grp.add(face);
    const an=analyze(tx.image);
    if(an){const core=new THREE.MeshStandardMaterial({color:an.color,roughness:.5,metalness:.05,transparent:true,opacity:0});rec.coreMat=core;
      an.bands.forEach(([y0,y1,w],bi)=>{if(w<.12)return;if(bi===0&&(wide||w<.3))return;const k=bi===0?.5:bi===1?.78:.86;const cw=w*pw*k,ch=(y1-y0)*ph*(bi===0?.7:.98);const cy=ph-(y0+y1)/2*ph;
        const zs=wide?.3:.6;const m=new THREE.Mesh(new THREE.CylinderGeometry(cw/2,cw/2,ch,40),core);m.scale.z=zs;m.position.set(0,cy,-(cw/2)*zs-.01);m.castShadow=true;grp.add(m);});}
    grp.userData.ready=true;

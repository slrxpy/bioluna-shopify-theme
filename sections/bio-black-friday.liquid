  const front=new THREE.Mesh(new THREE.BoxGeometry(dw,dh,.05),[mCream2,mCream2,mCream2,mCream2,faceMat,mCream2]);front.position.z=D/2-.025;front.castShadow=true;front.receiveShadow=true;g.add(front);
  // body (open-top tray)

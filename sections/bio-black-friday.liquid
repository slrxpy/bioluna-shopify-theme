/* doors */
const doorSrc=doorFaceCanvas();
const doorMat=(left)=>[mCream,mCream,mCream,mCream,new THREE.MeshStandardMaterial({map:tex(halfCanvas(doorSrc,left)),roughness:.8}),mCream2];
const doorL=new THREE.Group(),doorR=new THREE.Group();doorL.position.set(-W/2,0,D/2);doorR.position.set(W/2,0,D/2);

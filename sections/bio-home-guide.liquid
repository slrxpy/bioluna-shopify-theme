<style>.bhg{max-width:1240px;margin:0 auto;padding:26px 16px}.bhg-in{background:linear-gradient(120deg,#fdf4f6,#fbe9ee 60%,#fdf6ec);border:1px solid #f2dde2;border-radius:20px;padding:22px 20px;text-align:center}.bhg h2{margin:0 0 4px;font-size:24px}.bhg p{margin:0 0 14px;color:#8a7a7e;font-size:14px}.bhg-b{display:flex;flex-wrap:wrap;gap:10px;justify-content:center}.bhg-b a{background:#fff;border:1px solid #f2dde2;border-radius:999px;padding:11px 16px;font-weight:700;font-size:14px;color:#1f1f1f;text-decoration:none;transition:.2s}.bhg-b a:hover{border-color:#d10a1e;color:#d10a1e;transform:translateY(-2px)}@media(max-width:640px){.bhg h2{font-size:20px}.bhg-b a{font-size:13px;padding:9px 13px}}</style>
<section class="bhg"><div class="bhg-in"><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.sub }}</p><div class="bhg-b">{%- for b in section.blocks -%}{%- assign c = collections[b.settings.collection] -%}<a href="{% if c != blank %}{{ c.url }}{% else %}{{ b.settings.url }}{% endif %}">{{ b.settings.label }}</a>{%- endfor -%}</div></div></section>
{% schema %}{ "name":"BioLuna – Ghid rapid","settings":[{"type":"text","id":"heading","label":"Titlu","default":"Nu știi de unde să începi?"},{"type":"text","id":"sub","label":"Subtitlu","default":"Alege ce te descrie și îți arătăm exact produsele potrivite"}],"blocks":[{"type":"btn","name":"Buton","settings":[{"type":"text","id":"label","label":"Text"},{"type":"collection","id":"collection","label":"Colecție"},{"type":"url","id":"url","label":"sau URL"}]}],"presets":[{"name":"BioLuna – Ghid rapid"}] }{% endschema %}

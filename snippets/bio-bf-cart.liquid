{%- comment -%} BioLuna BF – coș de Black Friday + upsell pe produs. Se încarcă o dată, doar pe paginile *.bf.
Reguli upsell: din aceeași familie cu produsul, nu mai scump decât el, nu un tip care e deja în produs/coș (ex. pachet cu loțiune -> fără loțiune). {%- endcomment -%}
{%- assign bfu_list = 'magiun|pachet-6-ciocolata-q7-gold-pentru-ea|ciocolata,magiun|pachet-6-ciocolata-q7-gold-pentru-el|ciocolata,magiun|pachet-testare-q7-gold-el-ea-2-plicuri|plic,magiun|plic-themra-magiun-afrodisiac-1-bucata-15g|plic,ceai|cafea-slabit-detox-ozlex-30-plicuri-original-turcia|cafea,ceai|odorizant-camera-alya-gourmand-french-vanilla-100ml|odorizant,ceai|odorizant-camera-alya-gourmand-caramel-cookie-100ml|odorizant,par|balsam-bifazic-redist-miracle-oil-40-overdose-400ml-leave-in|balsam,par|parfum-par-redist-miracle-oil-50ml-stralucire-luxoasa|parfum,par|lotiune-de-corp-redist-silky-vanilla-sugar-250ml|lotiune,sadoer|spray-par-sadoer-batana-oil-30ml-leave-in-reparator-protecti|spray,sadoer|ulei-par-sadoer-batana-oil-100ml-tratament-regenerator-premi|ulei,sadoer|lotiune-corp-sadoer-avocado-250ml|lotiune,odor|odorizant-camera-air-energie-lavanda-100ml|aroma,odor|odorizant-camera-air-energie-lamaie-100ml|aroma,odor|odorizant-camera-alya-gourmand-french-vanilla-100ml|aroma' | split: ',' -%}
<script type="application/json" id="bfu-data">[
{%- assign first = true -%}
{%- for row in bfu_list -%}{%- assign a = row | split: '|' -%}{%- assign p = all_products[a[1]] -%}
{%- if p != blank and p.available -%}{%- assign v = p.selected_or_first_available_variant -%}
{%- unless first -%},{%- endunless -%}{%- assign first = false -%}
{"f":{{ a[0] | json }},"k":{{ a[2] | json }},"h":{{ p.handle | json }},"pid":{{ p.id }},"vid":{{ v.id }},"t":{{ p.title | split: ' – ' | first | split: ' | ' | first | json }},"p":{{ v.price }},"c":{{ v.compare_at_price | default: 0 }},"img":{{ p.featured_image | image_url: width: 160 | json }},"u":{{ p.url | json }}}
{%- endif -%}{%- endfor -%}
]</script>
{%- assign bfe_list = 'ceai-slabit-ozlex-detox-60-plicuri-original-turcia,miere-afrodisiaca-themra-plante-240g-borcan-original-turcia,pachet-promo-redist-usturoi-sampon-1000ml-masca-475ml' | split: ',' -%}
{%- assign bfe_cats = 'Ceai Ozlex:ozlex-detox-slabit-complet|Redist:redist-professional|Magiun Themra:themra-miere-magiun-afrodisiac-original-turcia|Q7:q7-premium-magiun-ciocolata-afrodisiaca-turcia|Şahımerdan:magiun-sahimerdan|Sadoer:sadoer-professional|Odorizante:odorizante-de-camera' | split: '|' -%}
<template id="bfe-tpl"><div class="bfe">
  <div class="bfe__top"><span class="bfe__k">Black Friday</span><b>Coșul tău e gol</b><p>Reducerile sunt active până pe 30 noiembrie. Începe cu ce se cumpără cel mai des:</p></div>
  <div class="bfe__list">
  {%- for h in bfe_list -%}{%- assign p = all_products[h] -%}{%- if p != blank and p.available -%}{%- assign v = p.selected_or_first_available_variant -%}{%- assign cut = p.metafields.custom.bf_cutout.value -%}
    <div class="bfu__it"><a href="{{ p.url }}"><img src="{%- if cut != blank -%}{{ cut | image_url: width: 160 }}{%- else -%}{{ p.featured_image | image_url: width: 160 }}{%- endif -%}" alt="" loading="lazy" width="56" height="56"></a><div class="bfu__n"><a href="{{ p.url }}">{{ p.title | split: ' – ' | first | split: ' | ' | first }}</a><div class="bfu__p">{{ v.price | money }}{%- if v.compare_at_price > v.price -%}<s>{{ v.compare_at_price | money }}</s>{%- endif -%}</div></div><button type="button" class="bfu__b" data-bfu-add="{{ v.id }}">+ Adaugă</button></div>
  {%- endif -%}{%- endfor -%}
  </div>
  <div class="bfe__cats"><span>Sau alege o categorie</span><div>{%- for r in bfe_cats -%}{%- assign lh = r | split: ':' -%}{%- assign c = collections[lh[1]] -%}{%- if c != blank -%}<a href="{{ c.url }}">{{ lh[0] }}</a>{%- endif -%}{%- endfor -%}</div></div>
  <a class="bfe__all" href="{{ collections['toate-pachetele-promo'].url }}">Vezi toate reducerile</a>
</div></template>
<style>
/* butoane: fără umplerea temei la apăsare (făcea textul invizibil) */
body.bf #CartDrawer button[name="checkout"]::before,body.bf #CartDrawer button[name="checkout"]::after,body.bf .product-form__submit::before{display:none !important}
body.bf #CartDrawer button[name="checkout"],body.bf #CartDrawer button[name="checkout"]:hover,body.bf #CartDrawer button[name="checkout"]:focus,body.bf #CartDrawer button[name="checkout"]:active{background:var(--bf-cta) !important;animation:none !important;color:#fff !important;border:0 !important;border-radius:999px !important;box-shadow:0 10px 24px rgba(37,99,235,.32) !important;font-weight:800 !important;opacity:1 !important}
body.bf #CartDrawer button[name="checkout"] .btn__text{color:#fff !important}
body.bf #CartDrawer button[name="checkout"]:active{filter:brightness(.9)}
/* coș BF */
body.bf #CartDrawer .drawer__footer-buttons{flex-wrap:wrap;gap:6px !important}
body.bf #CartDrawer .drawer__footer-buttons button[name="checkout"]{flex:1 1 100%;order:1;padding-top:16px !important;padding-bottom:16px !important;font-size:15px !important}
body.bf #CartDrawer .drawer__footer-buttons a.btn{flex:1 1 100%;order:2;background:transparent !important;border:0 !important;box-shadow:none !important;padding:6px 0 0 !important;min-height:0 !important;font-size:13px !important;color:#444 !important;text-decoration:underline;text-underline-offset:3px}
body.bf #CartDrawer .drawer__footer-buttons a.btn::before,body.bf #CartDrawer .drawer__footer-buttons a.btn::after{display:none !important}
body.bf #CartDrawer .drawer__footer-buttons a.btn .btn__text{color:#444 !important}
body.bf #CartDrawer .cart-drawer-products-recommendation,body.bf #CartDrawer .bc-up{display:none !important}
body.bf #CartDrawer .drawer__inner{background:#f6f8fc}
.bfu{margin:12px 14px 14px;background:#fff;border:1px solid #e3e8f3;border-radius:16px;padding:12px 14px 6px;box-shadow:0 6px 18px rgba(20,48,110,.06);font-family:var(--bf-bf,inherit);color:#111}
.bfu__h{display:flex;align-items:baseline;justify-content:space-between;gap:10px;margin:0 0 4px}
.bfu__h b{font-family:var(--bf-hf);font-weight:800;font-size:21px;line-height:1;text-transform:uppercase;color:#111}
.bfu__h span{font-size:11.5px;color:#6b7280;white-space:nowrap}
.bfu__it{display:flex;align-items:center;gap:11px;padding:10px 0;border-top:1px solid #eef1f6}
.bfu__it:first-of-type{border-top:0}
.bfu__it img{flex:0 0 56px;width:56px;height:56px;object-fit:contain;border-radius:12px;background:#f3f5fa}
.bfu__n{flex:1;min-width:0}
.bfu__n a{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font-size:13px;font-weight:700;line-height:1.25;color:#111;text-decoration:none}
.bfu__p{margin-top:3px;font-size:13.5px;font-weight:800;color:var(--bf-red2,#c40016)}
.bfu__p s{font-weight:500;color:#8b8b8b;font-size:12px;margin-left:6px}
.bfu__b{flex:0 0 auto;border:0;cursor:pointer;background:var(--bf-cta);color:#fff;border-radius:999px;padding:10px 15px;font-size:12.5px;font-weight:800;font-family:inherit;white-space:nowrap;-webkit-tap-highlight-color:transparent}
.bfu__b:active{filter:brightness(.9)}
.bfu__b.on{background:#0d8756}
.bfu__b[disabled]{opacity:.7}
/* coș gol de BF */
body.bf #CartDrawer .cart-drawer__empty>:not(.bfe){display:none !important}
body.bf #CartDrawer .cart-drawer__empty{display:block !important;text-align:left !important;padding:0 !important;gap:0 !important}
.bfe{font-family:var(--bf-bf,inherit);color:#111;padding:4px 2px 18px}
.bfe__top{background:#0b0b0d;color:#fff;border-radius:18px;padding:20px 18px 18px;margin:0 0 12px}
.bfe__k{display:inline-block;font-size:10.5px;font-weight:800;letter-spacing:.24em;text-transform:uppercase;color:#ff5a5f;margin-bottom:8px}
.bfe__top b{display:block;font-family:var(--bf-hf);font-weight:800;font-size:34px;line-height:.95;text-transform:uppercase;color:#fff}
.bfe__top p{margin:9px 0 0;font-size:13.5px;line-height:1.45;color:#c9ccd3}
.bfe__list{background:#fff;border:1px solid #e3e8f3;border-radius:16px;padding:2px 14px}
.bfe__cats{margin:16px 0 0}
.bfe__cats span{display:block;font-size:12px;font-weight:700;color:#5b616b;margin:0 2px 9px}
.bfe__cats div{display:flex;flex-wrap:wrap;gap:7px}
.bfe__cats a{display:inline-flex;align-items:center;border:1px solid #d5dae3;background:#fff;border-radius:999px;padding:9px 14px;font-size:13px;font-weight:600;line-height:1;color:#111;text-decoration:none}
.bfe__cats a:hover{border-color:#111}
.bfe__all{display:block;text-align:center;margin:18px 0 0;background:var(--bf-cta);color:#fff !important;border-radius:999px;padding:15px 16px;font-size:14.5px;font-weight:800;text-decoration:none;box-shadow:0 10px 24px rgba(37,99,235,.28)}
.bfe__all:active{filter:brightness(.92)}
</style>
<script>
(function(){
  if(window.BFU) return;
  var D=[]; try{D=JSON.parse(document.getElementById('bfu-data').textContent||'[]')}catch(e){}
  var KW={cafea:['cafea','coffee'],ciocolata:['ciocolat'],plic:['plic'],balsam:['balsam'],parfum:['parfum de par','parfum par'],lotiune:['lotiune'],spray:['spray'],ulei:['ulei'],odorizant:['odorizant','1001 de nopti','parfum de camera','reed diffuser'],aroma:[]};
  var FAM={'themra':'magiun','q7 premium':'magiun','sahimerdan':'magiun','lotus premium':'magiun','vital honey':'magiun','ozlex':'ceai','21 days coffee':'ceai','for x5':'ceai','redist professional':'par','lilamor professional':'par','sadoer professional':'sadoer','alya':'odor','air energie':'odor','1001 de nopți':'odor','yumos':'odor'};
  function norm(s){return (s||'').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g,'')}
  function money(c){return (c/100).toFixed(2).replace('.',',')+' lei'}
  function fam(vendor){return FAM[(vendor||'').toLowerCase()]||''}
  /* items: [{vendor,title,handle,price}] -> max n recomandări */
  function pick(items,n){
    var titles=items.map(function(i){return norm(i.title)}), handles=items.map(function(i){return i.handle}), maxBy={}, out=[], kinds={}, rest=[];
    items.forEach(function(i){var f=fam(i.vendor);if(f)maxBy[f]=Math.max(maxBy[f]||0,i.price)});
    D.forEach(function(c){
      if(!maxBy[c.f]||c.p>maxBy[c.f]||handles.indexOf(c.h)>-1) return;
      if(out.some(function(o){return o.h===c.h})||rest.some(function(o){return o.h===c.h})) return;
      var kw=KW[c.k]||[]; for(var a=0;a<kw.length;a++){for(var b=0;b<titles.length;b++){if(titles[b].indexOf(kw[a])>-1) return;}}
      if(kinds[c.f+c.k]&&c.k!=='aroma') rest.push(c); else {kinds[c.f+c.k]=1; out.push(c);}
    });
    return out.concat(rest).slice(0,n||2);
  }
  function html(list,title,sub){
    return '<div class="bfu__h"><b>'+title+'</b><span>'+sub+'</span></div>'+list.map(function(c){return '<div class="bfu__it"><a href="'+c.u+'"><img src="'+c.img+'" alt="" loading="lazy" width="56" height="56"></a><div class="bfu__n"><a href="'+c.u+'">'+c.t+'</a><div class="bfu__p">'+money(c.p)+(c.c>c.p?'<s>'+money(c.c)+'</s>':'')+'</div></div><button type="button" class="bfu__b" data-bfu-add="'+c.vid+'">+ Adaugă</button></div>'}).join('');
  }
  function count(){return fetch('/cart.js').then(function(r){return r.json()}).then(function(c){document.querySelectorAll('cart-count,.cart-count').forEach(function(e){e.textContent=c.item_count;e.hidden=false;e.classList.remove('hidden')});return c})}
  function refresh(){var dr=document.getElementById('CartDrawer'),sid=dr&&dr.getAttribute('data-section-id');if(!sid)return Promise.resolve();return fetch('/?sections='+sid).then(function(r){return r.json()}).then(function(j){var tmp=document.createElement('div');tmp.innerHTML=j[sid];var a=tmp.querySelector('.drawer__inner'),b=dr.querySelector('.drawer__inner');if(a&&b)b.innerHTML=a.innerHTML}).catch(function(){})}
  function add(vid,btn){
    if(btn){btn.disabled=true;btn.textContent='…'}
    return fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({items:[{id:vid,quantity:1}]})}).then(function(r){if(!r.ok)throw 0;if(btn){btn.textContent='✓ În coș';btn.classList.add('on')}return refresh()}).then(count).catch(function(){if(btn){btn.disabled=false;btn.textContent='+ Adaugă'}});
  }
  document.addEventListener('click',function(e){var b=e.target.closest&&e.target.closest('[data-bfu-add]');if(b){e.preventDefault();add(b.getAttribute('data-bfu-add'),b)}});
  window.BFU={pick:pick,html:html,add:add,money:money};
  /* ---- coș ---- */
  var tmr=null,busy=false;
  function ensure(){
    var dr=document.getElementById('CartDrawer');if(!dr||busy)return;var em=dr.querySelector('.cart-drawer__empty');if(em&&!em.querySelector('.bfe')){var et=document.getElementById('bfe-tpl');if(et)em.appendChild(et.content.firstElementChild.cloneNode(true))}if(dr.hidden)return;var body=dr.querySelector('.drawer__body:not(.hidden):not(.quick-view__content):not([id^="CartDrawerEmpty"])');if(!body)return;busy=true;
    fetch('/cart.js').then(function(r){return r.json()}).then(function(cart){
      var cur=body.querySelector('.bfu');
      if(!cart.items.length){if(cur)cur.remove();return}
      var sig=cart.items.map(function(i){return i.variant_id+'x'+i.quantity}).join(',');
      if(cur&&cur.getAttribute('data-sig')===sig)return;
      var list=pick(cart.items.map(function(i){return {vendor:i.vendor,title:i.product_title,handle:i.handle,price:i.final_price}}),3);
      if(cur)cur.remove(); if(!list.length)return;
      var n=document.createElement('div');n.className='bfu';n.setAttribute('data-sig',sig);n.innerHTML=html(list,'Completează comanda','un click și e în coș');body.appendChild(n);
    }).catch(function(){}).then(function(){busy=false});
  }
  function later(){clearTimeout(tmr);tmr=setTimeout(ensure,260)}
  function watch(){var dr=document.getElementById('CartDrawer');if(!dr)return;new MutationObserver(function(ms){for(var i=0;i<ms.length;i++){var m=ms[i];if(m.type==='attributes'){later();return}var mine=true;for(var k=0;k<m.addedNodes.length;k++){var x=m.addedNodes[k];if(!(x.classList&&x.classList.contains('bfu'))){mine=false;break}}if(!mine||m.removedNodes.length){later();return}}}).observe(dr,{attributes:true,attributeFilter:['hidden'],childList:true,subtree:true});later()}
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',watch);else watch();
})();
</script>

{%- comment -%} BioLuna BF – interfață comună (v6): meniu desktop, căutare, pagină de colecție curată, carduri. Se încarcă o singură dată din layout, doar pe template-urile *.bf. {%- endcomment -%}
<style>
/* ===== meniu desktop ===== */
@media(min-width:1024px){
  body.bf .header__bottom{background:#0b0b0d !important}
  body.bf .header__navigation{padding-top:0 !important;padding-bottom:0 !important}
  body.bf .header__menu>ul{gap:2px;flex-wrap:nowrap}
  body.bf .header__menu>ul>li{position:relative}
  body.bf .header__menu .menu__item{padding:19px 15px 18px !important}
  body.bf .header__menu .menu__item-text,body.bf .header__menu a.menu__item>.reversed-link{font-family:var(--bf-hf) !important;font-size:18px !important;font-weight:700 !important;letter-spacing:.05em !important;text-transform:uppercase;line-height:1 !important;background-image:none !important;color:#fff !important}
  body.bf .header__menu .menu__item-text svg{width:9px;height:9px;margin-left:7px;opacity:.7;transition:transform .18s}
  body.bf .header__menu details[open] .menu__item-text svg{transform:rotate(180deg)}
  body.bf .header__menu>ul>li:not(:first-child)::after{content:"";position:absolute;left:15px;right:15px;bottom:0;height:3px;background:var(--bf-red2);transform:scaleX(0);transform-origin:left center;transition:transform .2s}
  body.bf .header__menu>ul>li:not(:first-child):hover::after,body.bf .header__menu>ul>li:not(:first-child):focus-within::after{transform:scaleX(1)}
  body.bf .header__menu>ul>li:first-child{margin-right:10px}
  body.bf .header__menu>ul>li:first-child a.menu__item[href*="toate-pachetele-promo"]{padding:9px 16px 8px !important;border-radius:999px;background:var(--bf-sale) !important;animation:none !important;box-shadow:none !important;transform:none}
  body.bf .header__menu>ul>li:first-child a.menu__item[href*="toate-pachetele-promo"] .reversed-link{font-size:16px !important;letter-spacing:.06em !important}
  body.bf .header__menu>ul>li:first-child a.menu__item[href*="toate-pachetele-promo"]:hover{filter:brightness(1.08)}
  /* panoul */
  body.bf .header__menu details[level="top"] .dropdown{top:100% !important;max-width:none !important;width:max-content !important;min-width:0 !important;padding-top:0 !important}
  body.bf .header__menu details[level="top"] .dropdown__container{width:auto !important;min-width:270px;border:0 !important;border-radius:0 0 18px 18px !important;padding:20px 20px 16px !important;box-shadow:0 26px 50px rgba(0,0,0,.2) !important;background:#fff !important}
  body.bf .header__menu details[level="top"] .dropdown__nav{display:grid;grid-template-columns:1fr;gap:2px 16px;min-width:0 !important;margin:0}
  body.bf .header__menu details[level="top"] .dropdown__nav.bio-2col{grid-template-columns:repeat(2,minmax(215px,1fr));min-width:0 !important}
  body.bf .header__menu details[level="top"] .dropdown__nav>li:not(.bio-dd-head)>a{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:10px 12px;border-radius:10px;font-size:14.5px;font-weight:600;color:#111 !important;white-space:nowrap}
  body.bf .header__menu details[level="top"] .dropdown__nav>li>a::before{display:none !important}
  body.bf .header__menu details[level="top"] .dropdown__nav>li:not(.bio-dd-head)>a::after{content:"";flex:0 0 7px;width:7px;height:7px;border-right:2px solid #c3c9d4;border-top:2px solid #c3c9d4;transform:rotate(45deg);transition:transform .15s,border-color .15s}
  body.bf .header__menu details[level="top"] .dropdown__nav>li:not(.bio-dd-head)>a:hover{background:#f3f5fa !important}
  body.bf .header__menu details[level="top"] .dropdown__nav>li:not(.bio-dd-head)>a:hover::after{border-color:var(--bf-blue);transform:translateX(3px) rotate(45deg)}
  body.bf .header__menu .bio-dd-head{grid-column:1/-1;display:flex;align-items:baseline;justify-content:space-between;gap:28px;padding:0 12px 13px;margin:0 0 8px;border-bottom:1px solid #e9ecf2}
  body.bf .header__menu .bio-dd-head b{font-family:var(--bf-hf);font-size:25px;font-weight:800;letter-spacing:.02em;text-transform:uppercase;line-height:1;color:#111}
  body.bf .header__menu details[level="top"] .dropdown__nav>li.bio-dd-head>a{display:inline-block;width:auto;padding:0 !important;background:none !important;border-radius:0;font-size:13px;font-weight:700;white-space:nowrap;color:var(--bf-blue) !important;text-decoration:underline;text-underline-offset:4px}
  body.bf .header__menu details[level="top"] .dropdown__nav>li.bio-dd-head>a::after{display:none}
}
/* ===== căutare (tabletă + desktop) ===== */
@media(min-width:750px){
  body.bf .header__search .search__types{display:none !important}
  body.bf .header__search predictive-search{max-width:380px}
  body.bf .header__search .search__input{height:46px !important;padding:0 54px 0 20px !important;border:1.5px solid #111 !important;border-radius:999px !important;background:#fff !important;font-size:14.5px !important;color:#111 !important;box-shadow:none !important;transition:border-color .15s,box-shadow .15s}
  body.bf .header__search .search__input::placeholder{color:#7b808a;opacity:1}
  body.bf .header__search .search__input:focus{border-color:var(--bf-blue) !important;box-shadow:0 0 0 4px rgba(37,99,235,.15) !important;outline:0 !important}
  body.bf .header__search .search__icon-search{right:5px !important;left:auto !important;top:50% !important;transform:translateY(-50%);width:36px !important;height:36px !important;border-radius:50%;background:#111 !important;color:#fff !important;transition:background .15s}
  body.bf .header__search .search__icon-search:hover{background:var(--bf-blue) !important}
  body.bf .header__search .search__icon-search svg{width:16px;height:16px}
  body.bf .header__search .search__reset{right:18px !important;font-size:12px;color:#6b7280}
  body.bf .header__search .search__input:not(:placeholder-shown){padding-right:136px !important}
}
/* ===== căutare pe mobil (se deschide din lupă) ===== */
@media(max-width:749px){
  body.bf .header__search.bl-search-open predictive-search{padding:12px 14px !important;box-shadow:0 10px 30px rgba(0,0,0,.18) !important}
  body.bf .header__search.bl-search-open .search__types{display:none !important}
  body.bf .header__search.bl-search-open .search__input{height:48px !important;min-height:48px !important;padding:0 52px 0 18px !important;border:1.5px solid #111 !important;border-radius:999px !important;background:#fff !important;font-size:16px !important;color:#111 !important;box-shadow:none !important}
  body.bf .header__search.bl-search-open .search__input:focus{border-color:var(--bf-blue) !important;box-shadow:0 0 0 4px rgba(37,99,235,.15) !important;outline:0 !important}
  body.bf .header__search.bl-search-open .search__icon-search{right:5px !important;left:auto !important;top:50% !important;transform:translateY(-50%);width:38px !important;height:38px !important;border-radius:50%;background:#111 !important;color:#fff !important}
  body.bf .header__search.bl-search-open .search__icon-search svg{width:16px;height:16px}
  body.bf .header__search.bl-search-open .search__reset{right:16px !important;font-size:12px;color:#6b7280}
}
/* ===== pagina de colecție ===== */
.blf .bf-colhead{padding-top:26px;padding-bottom:0}
.blf .bf-colhead .bf-h{margin:6px 0 10px}
.blf .bf-colhead__row{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:nowrap}
.blf .bf-colhead__n{font-size:14px;color:#5b616b;line-height:1.3}
.blf .bf-colhead__n b{color:#111}
.blf .bf-colhead__n em{font-style:normal;font-weight:700;color:var(--bf-red2)}
.blf .bf-colhead__n i{font-style:normal}
.blf .bf-sort{flex:0 0 auto}
.blf .bf-sort select{border:1px solid #d5dae3;border-radius:999px;padding:10px 36px 10px 16px;font-size:13px;font-weight:600;background-position:right 14px center;cursor:pointer}
.blf .bf-sort select:focus-visible{outline:2px solid var(--bf-blue);outline-offset:2px}
.blf .bf-chips{display:flex;flex-wrap:wrap;gap:8px;margin:18px 0 22px}
.blf .bf-chip{display:inline-flex;align-items:center;border:1px solid #d5dae3;background:#fff;color:#111;border-radius:999px;padding:10px 17px;font-size:13.5px;font-weight:600;line-height:1;white-space:nowrap;transition:border-color .15s,background .15s}
.blf .bf-chip:hover{border-color:#111}
.blf .bf-chip.on{background:var(--bf-red2);border-color:var(--bf-red2);color:#fff}
.blf .bf-chip:focus-visible{outline:2px solid var(--bf-blue);outline-offset:2px}
.blf .bf-empty{grid-column:1/-1;padding:40px 0;text-align:center;color:#5b616b}
.blf .bf-empty a{color:var(--bf-blue);font-weight:700;text-decoration:underline}
/* carduri fără text în plus */
.blf .bf-grid--clean .bf-card{box-shadow:none;border-color:#e6e9ef}
.blf .bf-grid--clean .bf-card:hover{box-shadow:0 10px 26px rgba(17,24,39,.08)}
.blf .bf-grid--clean .bf-card__sv{display:none}
.blf .bf-grid--clean .bf-card__p{margin:8px 0 12px}
.blf .bf-grid--clean .bf-stars{font-size:12px;color:#6b7280;min-height:16px;white-space:nowrap;overflow:hidden}
.blf .bf-grid--clean .bf-stars i{font-size:12px;letter-spacing:.5px;margin-right:5px}
.blf .bf-grid--clean .bf-card__tag{font-size:9px;padding:4px 7px}
@media(max-width:767px){
  .blf .bf-colhead{padding-top:18px}
  .blf .bf-colhead__n i{display:none}.blf .bf-colhead__n span{display:block;margin-top:2px}
  .blf .bf-sort span{display:none}
  .blf .bf-sort select{padding:9px 32px 9px 13px;font-size:12.5px;max-width:170px}
  .blf .bf-chips{flex-wrap:nowrap;overflow-x:auto;scrollbar-width:none;-webkit-overflow-scrolling:touch;margin:14px -16px 16px;padding:0 16px}
  .blf .bf-chips::-webkit-scrollbar{display:none}
  .blf .bf-chip{padding:9px 14px;font-size:13px}
  .blf .bf-grid--clean .bf-card__t{font-size:15.5px;line-height:1.08}
  .blf .bf-grid--clean .bf-stars{font-size:11px}.blf .bf-grid--clean .bf-stars i{font-size:11px;letter-spacing:0;margin-right:4px}
  .blf .bf-grid--clean .bf-card__b{padding:10px 10px 10px}
  .blf .bf-grid--clean .bf-card__btn{padding:10px 6px}
}
</style>
<script>
(function(){function go(){var i=document.querySelector('.header__search .search__input');if(i)i.setAttribute('placeholder','Caută în reducerile de Black Friday');var f=document.querySelector('.header__search form');if(f&&!f.querySelector('input[name="type"]')){var h=document.createElement('input');h.type='hidden';h.name='type';h.value='product';f.appendChild(h)}}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',go);else go();})();
</script>

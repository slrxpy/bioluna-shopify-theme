{%- comment -%} JSON-LD breadcrumbs {%- endcomment -%}
{%- if template.name == 'product' -%}{%- assign bc_col = product.collections.first -%}
<script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Acasă","item":"{{ shop.url }}"}{% if bc_col %},{"@type":"ListItem","position":2,"name":{{ bc_col.title | json }},"item":"{{ shop.url }}{{ bc_col.url }}"}{% endif %},{"@type":"ListItem","position":{% if bc_col %}3{% else %}2{% endif %},"name":{{ product.title | json }},"item":"{{ shop.url }}{{ product.url }}"}]}</script>
{%- elsif template.name == 'collection' and collection -%}
<script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Acasă","item":"{{ shop.url }}"},{"@type":"ListItem","position":2,"name":{{ collection.title | json }},"item":"{{ shop.url }}{{ collection.url }}"}]}</script>
{%- elsif template.name == 'article' -%}
<script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Acasă","item":"{{ shop.url }}"},{"@type":"ListItem","position":2,"name":{{ blog.title | json }},"item":"{{ shop.url }}{{ blog.url }}"},{"@type":"ListItem","position":3,"name":{{ article.title | json }},"item":"{{ shop.url }}{{ article.url }}"}]}</script>
{%- endif -%}
<style id="bio-global">
h1,h2,h3,.h1,.h2,.h3,.product__title,.prh-title,.bcat h2,.bsr-hero h1,.ba h2{font-family:"Poppins",-apple-system,Segoe UI,Arial,sans-serif !important;font-weight:800 !important;letter-spacing:-.2px}

.product-card__wrapper{border:1px solid #f0e6e9;border-radius:16px;background:#fff;overflow:hidden;transition:transform .25s ease,box-shadow .25s ease}
.product-card__wrapper:hover{transform:translateY(-4px);box-shadow:0 14px 34px rgba(183,110,121,.16)}
.product-card__image img{transition:transform .5s ease}.product-card__wrapper:hover .product-card__image img{transform:scale(1.04)}
.product-card__info{padding:10px 12px 14px}
.product-card__title{font-size:14.5px;line-height:1.3;font-weight:700;margin:0 0 3px}
.bio-pc-sub{font-size:12px;color:#8a7a7e;margin:0 0 7px;line-height:1.35}
.bio-pc-ben{list-style:none;margin:0 0 8px;padding:0;font-size:12px;color:#2a2426;line-height:1.5}
.bio-pc-ben li:before{content:"•";color:#b76e79;font-weight:800;margin-right:6px}
.bio-pc-best{display:inline-block;background:linear-gradient(120deg,#f5d0a9,#e8b878);color:#5a3a00;border-radius:999px;padding:3px 9px;font-size:10.5px;font-weight:800;margin:0 0 6px}
.product-card .price__sale .price-item--sale,.product-card .price-item--sale,.price--on-sale .price-item--sale,.price__sale .price-item--sale{color:#d10a1e !important;font-weight:800}
.product-card .badge--sale,.product-card .badge{display:none !important}
.product-card__wrapper{position:relative}
.bio-stk{position:absolute;top:10px;right:10px;z-index:3;width:64px;height:64px;border-radius:50%;background:linear-gradient(135deg,#ff2a2a,#c40016);color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;transform:rotate(6deg);box-shadow:0 6px 18px rgba(196,0,22,.35);line-height:1.05;text-align:center}
.bio-stk b{font-size:16px;font-weight:900}.bio-stk small{font-size:8.5px;font-weight:700;opacity:.95}
.bio-stk.lg{width:96px;height:96px;top:14px;right:14px}.bio-stk.lg b{font-size:24px}.bio-stk.lg small{font-size:11px}
.bx-stk{background:linear-gradient(135deg,#ff2a2a,#c40016) !important}.bx-pcard .pr{color:#d10a1e !important}.bx-fbt-it .p,.bx-fbt-tot b{color:#d10a1e !important}
@media(max-width:640px){.product-card__info{padding:8px 9px 12px}.product-card__title{font-size:13px}.bio-pc-ben{font-size:11.5px}.bio-pc-sub{font-size:11px}}

/* --- bula PACHETE PROMO --- */
.header__menu>ul>li:first-child a.menu__item[href*="toate-pachetele-promo"]{background:linear-gradient(120deg,#ff2a2a,#c40016 60%,#ff6a3d);color:#fff !important;border-radius:999px;padding:6px 14px;font-weight:800;font-size:.8rem;text-transform:uppercase;letter-spacing:.3px;position:relative;transform:translateY(-1px);box-shadow:0 0 0 0 rgba(255,42,42,.55);animation:bio-pulse 2.4s ease-in-out infinite}
.header__menu>ul>li:first-child a.menu__item[href*="toate-pachetele-promo"] .reversed-link{color:#fff !important;background:none}
.header__menu>ul>li:first-child a.menu__item[href*="toate-pachetele-promo"]:hover{animation:none !important;box-shadow:0 8px 24px rgba(196,0,22,.45)}
@keyframes bio-pulse{0%,100%{box-shadow:0 0 0 0 rgba(255,42,42,.5)}50%{box-shadow:0 0 0 9px rgba(255,42,42,0)}}

/* --- meniu desktop: fixuri --- */
.header__menu>ul>li:first-child{margin-right:6px}
.header__menu>ul>li{display:inline-flex;align-items:center}
.header__menu details[level="top"] summary{display:flex;align-items:center}
.header__menu>ul{gap:2px;align-items:center}
.header__menu .menu__item{padding:10px 12px !important}
.header__menu .menu__item-text{font-size:14.5px;letter-spacing:.1px}
.header__menu details[level="top"] .dropdown{z-index:60}
.header__menu details[level="top"] .dropdown__container{background:#fff !important;color:#1f1f1f !important}
.header__menu details[level="top"] .dropdown__nav>li>a,.header__menu details[level="top"] .dropdown__nav>li>a .reversed-link__text{color:#1f1f1f !important;background-image:none !important}
.header__menu details[level="top"].bio-right .dropdown{left:auto !important;right:0 !important}
.header__menu details[level="top"] .dropdown__nav.bio-2col{min-width:520px}
/* --- mega dropdown --- */
.header__menu details[level="top"] .dropdown{padding-top:12px}
.header__menu details[level="top"] .dropdown__container{border-radius:18px !important;box-shadow:0 22px 60px rgba(0,0,0,.14),0 2px 8px rgba(0,0,0,.06);padding:16px 18px 14px !important;min-width:300px;border:1px solid #f0e6e9}
.header__menu details[level="top"] .dropdown__nav{display:grid;grid-template-columns:1fr;gap:2px;margin:0}
.header__menu details[level="top"] .dropdown__nav.bio-2col{grid-template-columns:1fr 1fr;min-width:560px;column-gap:22px}
.header__menu details[level="top"] .dropdown__nav>li{margin:0}
.header__menu details[level="top"] .dropdown__nav>li>a{padding:8px 10px;border-radius:10px;display:flex;align-items:center;gap:8px;font-size:14px;transition:background .15s}
.header__menu details[level="top"] .dropdown__nav>li>a:before{content:"";width:6px;height:6px;border-radius:50%;background:#e8b4b8;flex:0 0 auto;transition:background .15s}
.header__menu details[level="top"] .dropdown__nav>li>a:hover{background:#fdf4f6}
.header__menu details[level="top"] .dropdown__nav>li>a:hover:before{background:#d10a1e}
.bio-dd-head{grid-column:1/-1;display:flex;justify-content:space-between;align-items:center;padding:0 10px 10px;margin-bottom:6px;border-bottom:1px solid #f0e6e9}
.bio-dd-head b{font-size:12px;letter-spacing:1.4px;text-transform:uppercase;color:#8a7a7e}
.bio-dd-head a{font-size:13px;font-weight:800;color:#d10a1e;text-decoration:none}
.header__menu .menu__item-text{font-weight:600}

/* ===== articole blog ===== */
.ba{max-width:760px;margin:0 auto;font-size:16px;line-height:1.7;color:#1f1f1f}
.ba-intro{background:linear-gradient(120deg,#fdf4f6,#fbe9ee 60%,#fdf6ec);border:1px solid #f2dde2;border-radius:18px;padding:18px 20px;margin:0 0 18px;font-size:16.5px}
.ba-toc{margin:0 0 22px}.ba-toc b{display:block;font-size:12px;letter-spacing:1.4px;text-transform:uppercase;color:#8a7a7e;margin-bottom:8px}
.ba-toc a{display:inline-block;background:#fff;border:1px solid #f2dde2;border-radius:999px;padding:6px 12px;font-size:13px;font-weight:700;color:#1f1f1f;text-decoration:none;margin:0 6px 6px 0}
.ba h2{font-size:22px;margin:30px 0 10px;padding-left:14px;border-left:4px solid #d10a1e;line-height:1.25}
.ba h3{font-size:17px;margin:20px 0 8px}
.ba ul.ck{list-style:none;padding:0;margin:0 0 14px}.ba ul.ck li{padding:5px 0 5px 28px;position:relative}.ba ul.ck li:before{content:"✓";position:absolute;left:0;top:5px;width:20px;height:20px;border-radius:50%;background:linear-gradient(120deg,#b76e79,#d48a9b);color:#fff;font-size:12px;display:flex;align-items:center;justify-content:center}
.ba .tip{background:#fdf6ec;border:1px solid #f0dcb8;border-radius:14px;padding:12px 16px;margin:14px 0;font-size:15px}.ba .tip b{color:#8a5a00}
.ba .warn{background:#fff5f5;border:1px solid #f5c2c2;border-radius:14px;padding:12px 16px;margin:14px 0;font-size:15px}.ba .warn b{color:#c40016}
.ba ol.st{list-style:none;counter-reset:s;padding:0;margin:0 0 14px}.ba ol.st li{counter-increment:s;position:relative;padding:8px 0 8px 46px;border-bottom:1px dashed #f0e6e9}.ba ol.st li:before{content:counter(s);position:absolute;left:0;top:8px;width:32px;height:32px;border-radius:50%;background:linear-gradient(120deg,#ff2a2a,#c40016);color:#fff;font-weight:800;display:flex;align-items:center;justify-content:center}
.ba-prod{display:flex;gap:14px;align-items:center;background:#fff;border:1px solid #f2dde2;border-radius:16px;padding:12px;margin:12px 0;text-decoration:none;color:#1f1f1f;transition:transform .2s,box-shadow .2s}.ba-prod:hover{transform:translateY(-2px);box-shadow:0 10px 28px rgba(183,110,121,.16)}
.ba-prod img{width:84px;height:84px;object-fit:cover;border-radius:12px;flex:0 0 auto;background:#faf3f3}
.ba-prod .t{font-weight:800;font-size:15px;line-height:1.3}.ba-prod .d{font-size:13px;color:#8a7a7e;margin:3px 0 5px}.ba-prod .p{font-weight:800;color:#d10a1e;font-size:16px}.ba-prod .p s{color:#8a7a7e;font-weight:400;font-size:13px;margin-left:6px}.ba-prod .go{font-size:13px;font-weight:700;color:#b76e79}
.ba-faq details{background:#fff;border:1px solid #f2dde2;border-radius:12px;padding:0 14px;margin:6px 0}.ba-faq summary{cursor:pointer;font-weight:700;padding:12px 0;list-style:none}.ba-faq summary::-webkit-details-marker{display:none}.ba-faq summary:after{content:"+";float:right;color:#d10a1e;font-size:18px}.ba-faq details[open] summary:after{content:"–"}.ba-faq p{margin:0 0 12px;color:#4a4448;font-size:15px}
.ba-cta{background:linear-gradient(120deg,#1f1f1f,#3a2a30);color:#fff;border-radius:18px;padding:22px;text-align:center;margin:26px 0}.ba-cta b{display:block;font-size:19px;margin-bottom:4px}.ba-cta p{margin:0 0 12px;opacity:.85;font-size:14.5px}.ba-cta a{display:inline-block;background:linear-gradient(120deg,#ff2a2a,#c40016);color:#fff;border-radius:999px;padding:11px 22px;font-weight:800;text-decoration:none}
.ba-more{margin:22px 0}.ba-more b{display:block;margin-bottom:8px}.ba-more a{display:block;padding:9px 12px;background:#fff;border:1px solid #f2dde2;border-radius:12px;margin:6px 0;text-decoration:none;color:#1f1f1f;font-weight:600;font-size:14.5px}
.ba-sig{display:flex;gap:12px;align-items:center;border-top:1px solid #f0e6e9;padding-top:16px;margin-top:22px;font-size:14px;color:#4a4448}.ba-sig i{width:44px;height:44px;border-radius:50%;background:linear-gradient(120deg,#b76e79,#d48a9b);color:#fff;font-style:normal;font-weight:800;display:flex;align-items:center;justify-content:center;flex:0 0 auto}
@media(max-width:640px){.ba{font-size:15.5px}.ba h2{font-size:19px}}

/* --- acordeoane descriere --- */
details.bd{background:#fff;border:1px solid #f0e6e9;border-radius:14px;padding:0 16px;margin:0 0 10px}
details.bd>summary{cursor:pointer;font-weight:800;font-size:15.5px;padding:14px 0;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:10px;color:#1f1f1f}
details.bd>summary::-webkit-details-marker{display:none}
details.bd>summary:after{content:"+";color:#d10a1e;font-size:20px;font-weight:400;flex:0 0 auto}
details.bd[open]>summary:after{content:"–"}
details.bd[open]>summary{border-bottom:1px solid #f5edf0}
details.bd .bd-c{padding:12px 0 14px}
details.bd .bd-c>div[style*="background:#faf7f2"],details.bd .bd-c>div[style*="background:#f4f8f0"],details.bd .bd-c>div[style*="background:#f3fbf9"],details.bd .bd-c>div[style*="background:#f4f8f4"]{background:transparent !important;border:0 !important;padding:0 !important;margin:0 !important}

/* --- cardul bio (global) --- */
.bx{--a:#b76e79;--a2:#d48a9b;--bg:#fdf4f6;--bd:#f2dde2;--tx:#1f1f1f;--mu:#7a6a6e}
.bx-row{display:flex;gap:12px;overflow-x:auto;padding:4px 2px 12px;scroll-snap-type:x mandatory}
.bx-pcard{flex:0 0 200px;scroll-snap-align:start;background:#fff;border:1px solid #f2dde2;border-radius:16px;overflow:hidden;text-decoration:none;color:#1f1f1f;position:relative;display:block;transition:transform .2s,box-shadow .2s}
.bx-pcard:hover{transform:translateY(-3px);box-shadow:0 12px 30px rgba(183,110,121,.16)}
.bx-pcard img{width:100%;aspect-ratio:1;object-fit:cover;display:block}
.bx-pcard .b{padding:10px 12px 12px}.bx-pcard .t{font-size:13.5px;font-weight:700;line-height:1.3;margin:0 0 4px}
.bx-pcard .s{font-size:11.5px;color:#7a6a6e;margin:0 0 6px}
.bx-pcard .m{font-size:11.5px;color:#1f1f1f;margin:0 0 8px;line-height:1.45}.bx-pcard .m span:before{content:"• ";color:#b76e79}
.bx-pcard .pr{font-weight:800;color:#d10a1e;font-size:15px}.bx-pcard .pr s{color:#7a6a6e;font-weight:400;font-size:12px;margin-left:5px}
.bx-stk{position:absolute;top:8px;right:8px;z-index:2;background:linear-gradient(135deg,#ff2a2a,#c40016);color:#fff;border-radius:50%;width:50px;height:50px;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:800;transform:rotate(6deg);box-shadow:0 5px 14px rgba(196,0,22,.35)}
@media(max-width:640px){.bx-pcard{flex-basis:160px}}
/* --- fara Conectare/Cont in header --- */
a.account-button,.account-button,a[aria-label="Contul meu"],a[href*="customer_authentication"],a[href*="/account/login"],shopify-account{display:none !important}
</style>
<script>
(function(){function go(){document.querySelectorAll('.header__menu details[level="top"]').forEach(function(d){var nav=d.querySelector('.dropdown__nav');if(!nav||nav.querySelector('.bio-dd-head'))return;var s=d.querySelector('summary');var link=s&&s.getAttribute('data-link');var t=s?s.textContent.trim():'';if(nav.children.length>6)nav.classList.add('bio-2col');var h=document.createElement('li');h.className='bio-dd-head';h.innerHTML='<b>'+t+'</b>'+(link?'<a href="'+link+'">Vezi toate →</a>':'');nav.insertBefore(h,nav.firstChild);var rect=d.getBoundingClientRect();if(rect.left+560>window.innerWidth)d.classList.add('bio-right');});}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',go);else go();})();
</script>
<script>
(function(){function go(){var els=document.querySelectorAll('.ba-prod[data-handle]');els.forEach(function(el){var h=el.getAttribute('data-handle');fetch('/products/'+h+'.js').then(function(r){return r.ok?r.json():null}).then(function(p){if(!p){el.style.display='none';return;}var v=p.variants[0];var img=p.featured_image?p.featured_image.replace(/(\.[a-z]+)(\?|$)/,'_300x$1$2'):'';var price=(v.price/100).toFixed(2).replace('.',',')+' lei';var cmp=v.compare_at_price&&v.compare_at_price>v.price?'<s>'+(v.compare_at_price/100).toFixed(2).replace('.',',')+' lei</s>':'';el.innerHTML=(img?'<img src="'+img+'" alt="">':'')+'<div><div class="t">'+p.title.split(' – ')[0]+'</div><div class="d">'+(el.getAttribute('data-blurb')||'')+'</div><div class="p">'+price+cmp+'</div><div class="go">Vezi produsul →</div></div>';el.setAttribute('href','/products/'+h);}).catch(function(){el.style.display='none';});});}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',go);else go();})();
</script>
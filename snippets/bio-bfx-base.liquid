{%- comment -%} BioLuna BF v2 (lila/roz/galben) – stiluri comune. Se incarca o singura data. {%- endcomment -%}
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,800;9..144,900&family=Figtree:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
.bf2w{--ink:#2B1247;--paper:#F6F1FF;--pink:#E5127D;--sun:#FFE23D;--white:#fff;--mute:#6E5C86;font-family:Figtree,system-ui,sans-serif;color:var(--ink);background:var(--paper);-webkit-font-smoothing:antialiased}
.bf2w *{box-sizing:border-box;margin:0}.bf2w h1,.bf2w h2,.bf2w h3{color:var(--ink);text-transform:none;padding:0}.bf2w p{padding:0}.bf2w a{color:inherit;text-decoration:none}.bf2w img{display:block;max-width:100%}
.bf2w h1,.bf2w h2,.bf2w h3{font-family:Fraunces,Georgia,serif;font-weight:800;letter-spacing:-.02em;line-height:1.04}
.bf2w .w{max-width:1180px;margin:0 auto;padding:0 16px}
/* bara cu timpul ramas */
.bf2w .tm{background:var(--ink);color:#fff;font-size:14px;font-weight:600;text-align:center;padding:10px 12px}
.bf2w .tm b{font-variant-numeric:tabular-nums;color:var(--sun);font-weight:800;margin-left:4px}
/* hero */
.bf2w .hr{position:relative;overflow:hidden;padding:26px 0 0;background:radial-gradient(120% 80% at 85% 0%,#FFD3EA 0%,transparent 55%),var(--paper)}
.bf2w .hr h1{font-size:clamp(46px,13vw,104px);font-weight:900}
.bf2w .hr h1 i{font-style:italic;font-weight:600}
.bf2w .hr p{font-size:17px;line-height:1.5;color:var(--mute);margin:14px 0 20px;max-width:30ch}.bf2w .hr .w>div:first-child{padding-bottom:14px}
.bf2w .btn{display:inline-block;background:var(--pink);color:#fff;font-weight:800;font-size:16px;padding:16px 26px;border-radius:999px;box-shadow:0 6px 0 #A50B58}
.bf2w .btn:active{transform:translateY(4px);box-shadow:0 2px 0 #A50B58}
.bf2w .hr-art{position:relative;height:300px;margin-top:8px}
.bf2w .hr-art img{position:absolute;bottom:-6px;width:56%;mix-blend-mode:multiply;filter:drop-shadow(0 18px 18px rgba(43,18,71,.18))}
.bf2w .hr-art .h0{left:-6%;transform:rotate(-8deg);width:54%}.bf2w .hr-art .h1{left:24%;z-index:2;width:58%;bottom:-14px}.bf2w .hr-art .h2{right:-9%;transform:rotate(9deg);width:46%}
.bf2w .big{position:absolute;z-index:3;right:10px;top:-34px;width:128px;height:128px;border-radius:50%;background:var(--sun);display:grid;place-content:center;text-align:center;transform:rotate(-11deg);box-shadow:0 8px 0 #D9B800;font-family:Fraunces,serif}
.bf2w .big small{font:700 12px Figtree,sans-serif;display:block}.bf2w .big span{font-size:46px;font-weight:900;line-height:.9;letter-spacing:-.04em}
/* promisiuni */
.bf2w .ok{background:var(--pink);color:#fff}
.bf2w .ok ul{list-style:none;padding:13px 16px;display:flex;gap:18px;justify-content:space-between;font-weight:700;font-size:13.5px;max-width:1180px;margin:0 auto}
.bf2w .ok li{flex:1;text-align:center;line-height:1.25}
/* nevoi */
.bf2w .nd{padding:34px 0 8px}
.bf2w .nd>.w>h2,.bf2w .rw-h h2{font-size:clamp(28px,7.4vw,44px)}
.bf2w .nd>.w>p{color:var(--mute);margin:8px 0 18px;font-size:15.5px}
.bf2w .tls{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.bf2w .tl{position:relative;background:var(--bg);border-radius:26px 26px 26px 6px;padding:54px 14px 0;min-height:250px;overflow:hidden;display:flex;flex-direction:column}
.bf2w .tl:nth-child(even){border-radius:26px 26px 6px 26px}
.bf2w .tl h3{font-size:22px}.bf2w .tl p{font-size:13px;color:var(--mute);margin-top:5px;line-height:1.3}
.bf2w .tl img{margin:auto auto -10px;width:88%;mix-blend-mode:multiply}
.bf2w .stk{position:absolute;top:12px;left:12px;background:var(--ink);color:var(--sun);font-weight:800;font-size:12.5px;padding:6px 10px;border-radius:999px;transform:rotate(-3deg)}
.bf2w .tl.all{grid-column:1/-1;background:var(--ink);color:#fff;min-height:0;padding:22px 20px;border-radius:26px;flex-direction:row;align-items:center;justify-content:space-between;gap:14px}
.bf2w .tl.all h3{font-size:26px}.bf2w .tl.all p{color:#CDBCF0}.bf2w .tl.all .stk{position:static;background:var(--sun);color:var(--ink);font-size:15px;padding:10px 14px;white-space:nowrap}
/* randuri */
.bf2w .rw{padding:30px 0 4px}
.bf2w .rw-h{display:flex;align-items:end;justify-content:space-between;gap:12px;padding:0 16px;max-width:1180px;margin:0 auto 14px}
.bf2w .rw-h a{font-weight:700;font-size:14px;color:var(--pink);white-space:nowrap;border-bottom:2px solid currentColor;padding-bottom:1px}
.bf2w .rw-s{display:flex;gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;padding:0 16px 16px;scrollbar-width:none;max-width:1180px;margin:0 auto}
.bf2w .rw-s::-webkit-scrollbar{display:none}
.bf2w .pc{flex:0 0 62%;max-width:250px;scroll-snap-align:start;background:#fff;border-radius:20px;overflow:hidden;display:flex;flex-direction:column;border:1.5px solid #E7DDF7}
.bf2w .pc-im{position:relative;aspect-ratio:1;background:#fff}.bf2w .pc-im img{width:100%;height:100%;object-fit:contain}
.bf2w .pc-off{position:absolute;top:10px;left:10px;z-index:1;background:var(--sun);font:900 17px Fraunces,serif;padding:5px 9px;border-radius:10px;transform:rotate(-4deg)}
.bf2w .pc-b{padding:12px 14px 15px;display:flex;flex-direction:column;gap:5px;flex:1}
.bf2w .pc-v{font-size:12px;font-weight:700;color:var(--mute)}
.bf2w .pc h3{font:700 15px/1.3 Figtree,sans-serif;letter-spacing:0;min-height:39px}
.bf2w .pc-p{margin-top:auto;display:flex;align-items:baseline;gap:8px;flex-wrap:wrap}
.bf2w .pc-p b{font:900 22px Fraunces,serif;color:var(--pink)}.bf2w .pc-p s{font-size:13px;color:var(--mute)}
.bf2w .pc-s{font-size:12.5px;font-weight:700;color:#1E7A4D}
.bf2w .end{margin:26px 16px 0;padding:26px 20px 30px;border-radius:26px;background:var(--sun);text-align:center}
.bf2w .end h2{font-size:30px}.bf2w .end p{margin:8px 0 18px;font-size:15px}
.bf2w .end .btn{background:var(--ink);box-shadow:0 6px 0 #12061F}
.bf2w .ft{height:40px}
@media(min-width:800px){.bf2w .hr .w{display:grid;grid-template-columns:1.1fr 1fr;align-items:end;gap:30px}.bf2w .hr-art{height:460px}.bf2w .big{width:180px;height:180px;top:0}.bf2w .big span{font-size:66px}.bf2w .tls{grid-template-columns:repeat(5,1fr)}.bf2w .pc{flex-basis:23%}.bf2w .hr{padding-top:50px}.bf2w .ok ul{font-size:15px}}
@media(prefers-reduced-motion:no-preference){.bf2w .big{animation:pop .7s cubic-bezier(.2,1.6,.4,1) both .15s}@keyframes pop{from{transform:scale(.2) rotate(30deg);opacity:0}}}

.bf2w .tl img.cut,.bf2w .hr-art img.cut{mix-blend-mode:normal}
.bf2w .pc h3{color:var(--ink)}.bf2w .rw-h h2{margin:0}
.bf2w .tm[hidden]{display:none}
.bf2w h1,.bf2w h2,.bf2w h3,.bf2w .big,.bf2w .big span,.bf2w .pc-off,.bf2w .pc-p b{font-family:Fraunces,Georgia,serif !important}
.bf2w .pc h3{font-family:Figtree,system-ui,sans-serif !important;font-weight:700;font-size:15px;line-height:1.3}
.bf2w,.bf2w p,.bf2w a,.bf2w li,.bf2w .big small{font-family:Figtree,system-ui,sans-serif}
.bf2w .btn,.bf2w a{text-transform:none !important;letter-spacing:0}
.bf2w .tl.all h3{color:#fff}
.bf2w .hr h1{font-weight:900 !important}.bf2w .hr h1 i{font-weight:600 !important;font-style:italic}
</style>
